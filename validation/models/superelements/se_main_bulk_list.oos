[executive]
# ============================================================================
# O_o_Reader validation deck: main Bulk Data superelements (SESET, CSUPER, CSUPEXT, RELEASE, SETREE) (SOL 101)
#
# Validates:
#   - the exterior and interior points of list superelements, an identical
#     image (CSUPER), an exterior point added by CSUPEXT for an MPC-only
#     point, a released component (RELEASE), scalar points of a list
#     superelement, a two-level tree whose upstream exterior point is interior
#     to its downstream superelement
# Run notes:
#   - PARAM,POST,-2 writes the GPLS tables; the listing prints the exterior points
#     of each superelement
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: main Bulk Data superelements
BulkEcho;Sorted
SinglePointConstrSelection;1
MultiPointConstrSelection;50
StaticLoadSelection;1
SuperelementAllSteps;All
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;loads on superelements 1, 5 and the MPC point
[model]
Parameter;PostprocessingFile;-2
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Main Bulk Data superelements. The residual is a plate of 4 x 2 CQUAD4 (grid
# points 1 to 15) clamped at x = 0. Superelement 1 is a CHEXA block standing
# on the residual square 2-3-8-7 (its upper face interior, SESET 1);
# superelement 3 is an identical image of 1 standing on the square 4-5-10-9
# (CSUPER); superelement 2 is a plate of 2 CQUAD4 hanging below y = 0 whose
# exterior points are 2, 3, 4 with component 4 of point 3 released (RELEASE);
# superelement 5 is a CQUAD4 hanging on superelement 2 (two levels, SETREE 2
# 5) whose exterior point 205 is interior to 2; a scalar point 300 of
# superelement 2 carries a CELAS3; grid point 500, joined to superelement 1 by
# an MPC only, is made exterior by CSUPEXT. Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
SolidProp;2;1
