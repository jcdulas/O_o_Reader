[executive]
# ============================================================================
# O_o_Reader test model: plane strain, plane stress and axisymmetric elements
# of another implementation of the format (read only)
#
# Covers:
#   - cards: PPLANE, CPLSTN3, CPLSTN4, CPLSTN6, CPLSTN8, CPLSTS3, CPLSTS4,
#     CPLSTS6, CPLSTS8, CQUADX4, CQUADX8
#   - solution: SOL 101 (linear static, as another implementation of the format would run it)
#   - outputs: none (read and written by the library only)
# Run notes:
#   - not for the solver of the format reference: these entries belong to another implementation
#     that the format reference does not list; the
#     fields follow the layouts the library reads
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;other plane and axisymmetric elements (read only)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;blocks pulled along y
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, t. Steel; a plane strain property of unit thickness, a plane
# stress property 2 mm thick and a solid property for the axisymmetric
# quadrilaterals. Every element lies in the x-y plane.
IsoMat;1;2.1E+5;;0.3;7.85E-9
PlaneProp;1;1;1.
PlaneProp;2;1;2.;0.;0
SolidProp;3;1
# Plane strain: a triangle, a quadrilateral, a six-node triangle and an
# eight-node quadrilateral, each clamped at y = 0 and pulled at the top
Node;1;;0.;0.;0.;;3456
Node;2;;10.;0.;0.;;3456
Node;3;;0.;10.;0.;;3456
PlaneStrainTria3;1;1;1;2;3
Node;4;;20.;0.;0.;;3456
