[executive]
# ============================================================================
# O_o_Reader validation deck: optimisation with shape, material and connectivity relations (SOL 200)
#
# Validates:
#   - a moved shape (DVGRID) and the positions the solver writes at each cycle (the
#     punched final design, the result data geometry), DVMREL2 and DVCREL2 applied by
#     the solver, DVPREL1 on a PSHELL with Z1 and Z2 blank and on a PCOMP ply with Z0
#     blank
#   - the SOL 200 result tables (DESCYC, DBCOPT, HISADD, DESTAB, R1TABRG,
#     DSCMCOL, DSCM2) and the HDF5 optimisation datasets of the same run
#   - the design sensitivity print (DSAPRT) and the result tables of each
#     design cycle
# Run notes:
#   - PARAM,NASPRT,1 and DSAPRT print the sensitivities; the final design is
#     punched (.pch): bring it back
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;200
[case]
TitleText;O_o_Reader validation: optimisation with shape and relations
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DesignObjectiveSelection;31;MinimumObjective
SubcaseDesignConstrSelection;41
AnalysisKind;Statics
DesignSensitivityOutput;All;Formatted;Export;START=1
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip loads
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;DesignPrintFrequency;1
Parameter;DesignPunchOutput;1
# A plate of 4 x 2 CQUAD4 (PSHELL 1, Z1 and Z2 blank) and a laminate strip of
# 2 CQUAD4 (PCOMP 2, Z0 blank), a CBAR stiffener (PBAR 3) on the free edge.
# Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
OrthoMat2D;2;1.35E+5;9.E+3;0.3;5.E+3;5.E+3;3500.;1.6E-9
ShellProp;1;1;2.;1;;1
CompProp;2;;;;;;;;2;0.5;0.;Yes;2;0.5;90.;Yes
BarProp;3;1;20.;40.;30.;50.
Node;1;;0.;0.;0.
Node;2;;50.;0.;0.
Node;3;;100.;0.;0.
Node;4;;150.;0.;0.
Node;5;;200.;0.;0.
Node;6;;0.;50.;0.
Node;7;;50.;50.;0.
Node;8;;100.;50.;0.
Node;9;;150.;50.;0.
Node;10;;200.;50.;0.
Node;11;;0.;100.;0.
Node;12;;50.;100.;0.
Node;13;;100.;100.;0.
Node;14;;150.;100.;0.
Node;15;;200.;100.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;1;2;3;8;7
ShellQuad4;3;1;3;4;9;8
ShellQuad4;4;1;4;5;10;9
ShellQuad4;5;1;6;7;12;11
ShellQuad4;6;1;7;8;13;12
ShellQuad4;7;1;8;9;14;13
ShellQuad4;8;1;9;10;15;14
Node;21;;0.;200.;0.
Node;31;;0.;250.;0.
Node;22;;50.;200.;0.
Node;32;;50.;250.;0.
Node;23;;100.;200.;0.
Node;33;;100.;250.;0.
ShellQuad4;21;2;21;22;32;31
ShellQuad4;22;2;22;23;33;32
Bar2;31;3;5;10;0.;;0.;1.
Bar2;32;3;10;15;0.;;0.;1.
SinglePointConstrList;1;123456;1;6;11;21;31
PointForceLoad;1;15;;100.;0.;0.;1.
PointForceLoad;1;23;;50.;0.;0.;1.
PointForceLoad;1;33;;50.;0.;0.;1.
# Design variables: the plate thickness (1), the first ply thickness (2), a
# shape variable (3: DVGRID moves the free edge in z), the modulus factor (4:
# DVMREL2 on E of MAT1), the bar offset (5: DVCREL2 on X3 of CBAR 31). The
# starting values differ from the cards so that the first cycle writes them.
DesignVar;1;T;2.5;1.;5.
DesignVar;2;T1;0.6;0.2;2.
DesignVar;3;SHAPE;0.;-5.;5.
DesignVar;4;EFAC;1.;0.8;1.2
DesignVar;5;ORIENT;1.;0.5;2.
DesignPropRelation1;11;ShellProp;1;thickness;;;;1;1.
DesignPropRelation1;12;CompProp;2;plyThickness(1);;;;2;1.
DesignNodeMove;3;5;0;1.;0.;0.;1.
DesignNodeMove;3;10;0;1.;0.;0.;1.
DesignNodeMove;3;15;0;1.;0.;0.;1.
DesignNodeMove;3;10;0;0.5;0.;0.;1.
DesignEquation;21;E(F) = 70000.0 * F
DesignMatRelation2;22;IsoMat;1;youngsModulus;;;21;DesignVar;1;4
DesignEquation;23;XV(A) = A
DesignElemRelation2;24;Bar2;31;orientation3;;;23;DesignVar;1;5
# Responses: the weight (objective), the tip displacement and the plate von
# Mises stress (constraints), a DRESP2 combining two displacements.
DesignResp1;31;WEIGHT;Weight
DesignResp1;32;TIPDISP;Displacement;;;3;;15
DesignResp1;33;VMS;Stress;ShellProp;;9;;1
DesignEquation;34;DAV(U1,U2) = (U1 + U2) / 2.0
DesignResp2;35;AVGDISP;34;;;;;;;DesignResp1;2;32;32
DesignConstr;41;32;-2.;;2.
DesignConstr;41;33;;;150.
DesignConstr;41;35;-2.;;2.
DesignOptimParams;MaxDesignCycles;5;PrintInterval;1;PrintItems;15
