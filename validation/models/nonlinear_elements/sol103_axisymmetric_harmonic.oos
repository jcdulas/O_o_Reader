[executive]
# ============================================================================
# O_o_Reader test model: modes of an axisymmetric harmonic disk
#
# Covers:
#   - cards: PAXSYMH (linear harmonic CQUADX and CTRIAX)
#   - solution: SOL 103 (real eigenvalues, Lanczos)
#   - outputs: eigenvalues, eigenvectors, SPC forces
# Run notes:
#   - harmonic index 1 (the default); x basic is the radius, y basic the
#     axis; the disk is clamped at its bore
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader test model: axisymmetric harmonic disk (SOL 103)
BulkEcho;None
SinglePointConstrSelection;1
EigenMethodSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;first four modes, harmonic 1
[model]
Parameter;PostprocessingFile;-1
LanczosEigenMethod;1;;;4
# A steel disk of bore radius 20 mm, outer radius 90 mm, 10 mm thick:
# three CQUADX and two CTRIAX on a PAXSYMH (harmonic 1, default
# integration). Units: mm, N, t.
IsoMat;1;2.1E+5;;0.3;7.85E-9
AxisymHarmonicProp;40;1;;1;0
Node;1;;20.;0.;0.
Node;2;;40.;0.;0.
Node;3;;60.;0.;0.
Node;4;;80.;0.;0.
Node;5;;90.;0.;0.
Node;6;;20.;10.;0.
Node;7;;40.;10.;0.
Node;8;;60.;10.;0.
Node;9;;80.;10.;0.
Node;10;;90.;10.;0.
AxisymQuad;1;40;1;2;7;6
AxisymQuad;2;40;2;3;8;7
AxisymQuad;3;40;3;4;9;8
AxisymTria;4;40;4;5;10
AxisymTria;5;40;4;10;9
SinglePointConstrList;1;123;1;6
