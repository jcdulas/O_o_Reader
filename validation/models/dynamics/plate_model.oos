# Shared model of dynamics/ (INCLUDEd by the decks of this folder): an
# aluminium cantilever plate of 4 x 2 CQUAD4 (x 0 to 200, y 0 to 100, 2 mm
# thick, material damping GE = 0.02), clamped on its edge x = 0 (SPC set 1),
# with a 10 g mass at the free corner 15. Load set 1 is a unit force along z
# at that corner. First bending mode near 40 Hz. Units: mm, N, tonne, s.
IsoMat;1;7.E+4;;0.33;2.7E-9;;;0.02
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.
Node;2;;50.;0.;0.
Node;3;;100.;0.;0.
Node;4;;150.;0.;0.
Node;5;;200.;0.;0.
Node;6;;0.;50.;0.
Node;7;;50.;50.;0.
Node;8;;100.;50.;0.
Node;9;;150.;50.;0.
Node;10;;200.;50.;0.
Node;11;;0.;100.;0.
Node;12;;50.;100.;0.
Node;13;;100.;100.;0.
Node;14;;150.;100.;0.
Node;15;;200.;100.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;1;2;3;8;7
ShellQuad4;3;1;3;4;9;8
ShellQuad4;4;1;4;5;10;9
ShellQuad4;5;1;6;7;12;11
ShellQuad4;6;1;7;8;13;12
ShellQuad4;7;1;8;9;14;13
ShellQuad4;8;1;9;10;15;14
SinglePointConstrList;1;123456;1;6;11
PointMassInertia;20;15;0;1.E-5
PointForceLoad;1;15;0;1.;0.;0.;1.
