[executive]
# ============================================================================
# O_o_Reader test model: poroelastic trim component between plate and cavity
#
# Covers:
#   - cards: ACPEMCP, TRMCPL (with MATPE1, PSOLID PORO in a BEGIN BULK TRMC
#     part, ACMODL)
#   - solution: SOL 111 (modal frequency response of the plate and the
#     cavity coupled through the reduced impedance of the trim)
#   - outputs: complex displacements and fluid pressures, plate stresses
#     and forces, fluid element pressures
# Run notes:
#   - needs the PEM (poroelastic material) capability of the solver
#   - the 10 mm gap of acoustics/plate_cavity_model.inc is a foam layer of
#     4 x 4 CHEXA (trim component 1), glued to the plate on its bottom face
#     and open to the cavity on its top face; the plate and the cavity are
#     not coupled directly (ACMODL search height 0.5 mm, absolute)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;111
[case]
TitleText;O_o_Reader test model: 3D poroelastic trim (SOL 111)
BulkEcho;None
SinglePointConstrSelection;1
DynamicLoadSelection;21
FreqSetSelection;41
EigenMethodSelection;1;Structure
EigenMethodSelection;2;Fluid
TrimGroupSelection;All
SetDefinition;1;101;Through;116
DisplacementOutput;All;PlotOnly
StressOutput;1;PlotOnly
ElemForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;plate driven at (50, 50), foam-lined cavity
[model]
Parameter;PostprocessingFile;-1
Parameter;UniformStructuralDamping;0.02
LanczosEigenMethod;1;;2.E+3
LanczosEigenMethod;2;;4.E+3
FreqResponseLoad1;21;1;;;;;31
TableDynamic1;31;;;0.;1.;1.E+3;1.;EndTable
FreqLinearSteps1;41;50.;50.;9
# No direct coupling of the plate (z = 0) and the cavity floor (z = 10).
FluidStructureInterface;DifferenceForm;None;;;0.5;SurfaceCoupling;0.5;0.75;0.5;No;Absolute
# Trim component 1: glued to the structure (set 1 of the trim part), open
# to the cavity (set 2); tolerances of the two interfaces.
TrimComponentCoupling;1;1;;2
TrimCouplingTolerances;1;SolidGlued;0.1;1.
TrimCouplingTolerances;1;SolidOpen;0.1;1.
Include;plate_cavity_model.oos
[model;TrimComponent;1]
# Foam: skeleton (MAT1 with loss factor), air in the pores (MAT10),
# porosity, tortuosity, flow resistivity (N.s/mm4), characteristic lengths.
IsoMat;102;0.2;;0.3;3.E-11;;;0.1
FluidMat;103;0.142;1.2E-12
PoroElasticMat;101;102;103;;;;1.84E-11;1.4;0.71;0.95;1.4;2.5E-8;0.1;0.2
SolidProp;101;101;;;;;Poroelastic
# Trim grid points 7001 to 7025 (z = 0) and 7101 to 7125 (z = 10).
Node;7001;;0.;0.;0.
Node;7002;;50.;0.;0.
Node;7003;;100.;0.;0.
Node;7004;;150.;0.;0.
Node;7005;;200.;0.;0.
Node;7006;;0.;50.;0.
Node;7007;;50.;50.;0.
