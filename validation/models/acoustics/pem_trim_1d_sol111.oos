[executive]
# ============================================================================
# O_o_Reader test model: layered 1D analytical trim between plate and cavity
#
# Covers:
#   - cards: ACPMCP1, TCOMPG, TRMCPL (TRMSUR and INTERF; with PLTSURF,
#     SET3 and MATPE1 in a BEGIN BULK TRMC part, ACMODL)
#   - solution: SOL 111 (modal frequency response of the plate and the
#     cavity coupled through the reduced impedance of the trim)
#   - outputs: complex displacements and fluid pressures, plate stresses
#     and forces, fluid element pressures
# Run notes:
#   - needs the PEM (poroelastic material) capability of the solver
#   - the 10 mm gap of acoustics/plate_cavity_model.inc is a two-layer trim
#     (trim component 2): 8 mm of foam on the plate side, then a 2 mm heavy
#     layer kept at constant thickness, described by a bottom surface
#     (PLTSURF, z = 0, glued to the plate) and a top surface (z = 10, open
#     to the cavity); the plate and the cavity are not coupled directly
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;111
[case]
TitleText;O_o_Reader test model: 1D analytical trim (SOL 111)
BulkEcho;None
SinglePointConstrSelection;1
DynamicLoadSelection;21
FreqSetSelection;41
EigenMethodSelection;1;Structure
EigenMethodSelection;2;Fluid
TrimGroupSelection;All
SetDefinition;1;101;Through;116
DisplacementOutput;All;PlotOnly
StressOutput;1;PlotOnly
ElemForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;plate driven at (50, 50), trimmed cavity floor
[model]
Parameter;PostprocessingFile;-1
Parameter;UniformStructuralDamping;0.02
LanczosEigenMethod;1;;2.E+3
LanczosEigenMethod;2;;4.E+3
FreqResponseLoad1;21;1;;;;;31
TableDynamic1;31;;;0.;1.;1.E+3;1.;EndTable
FreqLinearSteps1;41;50.;50.;9
# No direct coupling of the plate (z = 0) and the cavity floor (z = 10).
FluidStructureInterface;DifferenceForm;None;;;0.5;SurfaceCoupling;0.5;0.75;0.5;No;Absolute
# Trim component 2, 1D method: bottom surface glued to the structure (SET3
# 1 of the trim part), top surface open to the cavity (SET3 2); search
# distances between the two trim surfaces and to the structure and cavity.
TrimComponentCoupling1D;2;1;;2;;0;OneDimensional
TrimCouplingTolerances;2;TrimSurface;0.1;12.
TrimCouplingTolerances;2;Interface;0.1;1.
Include;plate_cavity_model.oos
[model;TrimComponent;2]
# Foam (skeleton, air in the pores, porous parameters) and a heavy layer.
IsoMat;202;0.2;;0.3;3.E-11;;;0.1
FluidMat;203;0.142;1.2E-12
PoroElasticMat;201;202;203;;;;1.84E-11;1.4;0.71;0.95;1.4;2.5E-8;0.1;0.2
IsoMat;204;10.;;0.45;2.E-9;;;0.2
# Trim surfaces: grid points 8001 to 8025 and PLTSURF 8001 to 8016 at
# z = 0, grid points 8101 to 8125 and PLTSURF 8101 to 8116 at z = 10.
Node;8001;;0.;0.;0.
Node;8002;;50.;0.;0.
Node;8003;;100.;0.;0.
