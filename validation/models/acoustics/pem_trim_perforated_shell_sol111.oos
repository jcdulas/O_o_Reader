[executive]
# ============================================================================
# O_o_Reader test model: plate with a porous trim under a perforated facing
#
# Covers:
#   - cards: PSHLPF (with a trim component: BEGIN BULK TRMC, MATPE1, ACPEMCP,
#     TRMCPL)
#   - solution: SOL 111 (modal frequency response with a poro-elastic trim)
#   - outputs: displacements (complex, real and imaginary)
# Run notes:
#   - the trim is glued to the plate by ACPEMCP 1 and TRMCPL 1 of the main
#     Bulk Data; the glued set is the SET1 1 of the trim part (format reference ACPEMCP
#     remark 6: the sets are in BEGIN BULK TRMC)
#   - a PEM run: the trim component is computed by an external acoustic program, which
#     must be installed with the solver; units are SI (m, N, kg, s) as usual for
#     poro-elastic data
#   - the trim (a 20 mm porous layer of CHEXA and a perforated aluminium
#     facing of CQUAD4 on PSHLPF) is glued to the plate along z = 0
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;111
[case]
TitleText;perforated shell of a trim component (SOL 111)
BulkEcho;None
SinglePointConstrSelection;1
EigenMethodSelection;1
FreqSetSelection;2
DynamicLoadSelection;3
TrimGroupSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;unit force at the centre of the plate, 50 to 500 Hz
[model]
Parameter;PostprocessingFile;-1
Parameter;UniformStructuralDamping;0.02
LanczosEigenMethod;1;;3.E+3
FreqLinearSteps1;2;50.;50.;9
# A unit force normal to the plate at its centre, constant over frequency
FreqResponseLoad1;3;4;;;;;5
PointForceLoad;4;13;;1.;0.;0.;1.
TableDynamic1;5;;;0.;1.;5.E+3;1.;EndTable
# The structure: a steel plate 200 x 200 x 1 mm of sixteen CQUAD4 in the
# plane z = 0, clamped on its edges
IsoMat;1;2.1E+11;;0.3;7850.
ShellProp;1;1;0.001;1;;1
Node;1;;0.;0.;0.
Node;2;;0.05;0.;0.
Node;3;;0.1;0.;0.
Node;4;;0.15;0.;0.
Node;5;;0.2;0.;0.
Node;6;;0.;0.05;0.
Node;7;;0.05;0.05;0.
