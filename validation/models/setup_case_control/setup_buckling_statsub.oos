[executive]
# ============================================================================
# O_o_Reader validation deck: buckling with STATSUB, preload and buckling load (SOL 105)
#
# Validates:
#   - the static subcase the solver uses for the differential stiffness:
#     STATSUB(BUCKLING) and STATSUB(PRELOAD) in one buckling subcase, a bare
#     STATSUB in another
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;105
[case]
TitleText;O_o_Reader validation: buckling with STATSUB
BulkEcho;Sorted
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
AppliedLoadOutput;All;PlotOnly
SubcaseStart;1
LabelText;compression
StaticLoadSelection;1
SubcaseStart;2
LabelText;lateral preload
StaticLoadSelection;2
SubcaseStart;3
LabelText;buckling of the compression with the preload
EigenMethodSelection;5
StaticSubcaseSelection;1;Buckling
StaticSubcaseSelection;2;Preload
SubcaseStart;4
LabelText;buckling of the compression alone
EigenMethodSelection;5
StaticSubcaseSelection;1
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# A plate of 4 x 2 CQUAD4 clamped at x = 0 and loaded in compression at x =
# 40; load set 1 the compression, load set 2 a lateral preload. Units: mm, N,
# tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.
Node;2;;10.;0.;0.
Node;3;;20.;0.;0.
Node;4;;30.;0.;0.
Node;5;;40.;0.;0.
Node;6;;0.;10.;0.
Node;7;;10.;10.;0.
Node;8;;20.;10.;0.
Node;9;;30.;10.;0.
Node;10;;40.;10.;0.
Node;11;;0.;20.;0.
Node;12;;10.;20.;0.
Node;13;;20.;20.;0.
Node;14;;30.;20.;0.
Node;15;;40.;20.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;1;2;3;8;7
ShellQuad4;3;1;3;4;9;8
ShellQuad4;4;1;4;5;10;9
ShellQuad4;5;1;6;7;12;11
ShellQuad4;6;1;7;8;13;12
ShellQuad4;7;1;8;9;14;13
ShellQuad4;8;1;9;10;15;14
SinglePointConstrList;1;123456;1;6;11
PointForceLoad;1;5;;100.;-1.;0.;0.
PointForceLoad;2;5;;1.;0.;0.;1.
PointForceLoad;1;10;;100.;-1.;0.;0.
PointForceLoad;2;10;;1.;0.;0.;1.
PointForceLoad;1;15;;100.;-1.;0.;0.
PointForceLoad;2;15;;1.;0.;0.;1.
LanczosEigenMethod;5;;;3
