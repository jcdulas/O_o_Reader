[executive]
# ============================================================================
# O_o_Reader validation deck: Case Control set-up: SET with THRU and EXCEPT, TEMPERATURE forms, SUBCOM with SUBSEQ, SUBSEQ1 (SOL 101)
#
# Validates:
#   - the members the solver takes for SET lists with THRU, EXCEPT and BY (the IDs of
#     the result tables), the temperature sets the solver uses for the load and for
#     the material with TEMPERATURE(BOTH), a bare TEMPERATURE,
#     TEMPERATURE(LOAD) and TEMPERATURE(MATERIAL) in different subcases, the
#     combinations of SUBCOM with SUBSEQ (fewer factors than subcases) and
#     with SUBSEQ1, the plot sets
# Run notes:
#   - the listing echo and the subcase headings give the solver's reading; the result data tables
#     give the members of the sets
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: Case Control set-up
BulkEcho;Sorted
SinglePointConstrSelection;1
SetDefinition;1;1;2;4;Through;6;10;Through;15
SetDefinition;2;1;Through;4;6;Through;8
SetDefinition;3;2;5;8;11;14
DisplacementOutput;1;PlotOnly
StressOutput;2;PlotOnly
SinglePointConstrForceOutput;3;PlotOnly
SubcaseStart;1
LabelText;load 1, TEMPERATURE(BOTH) = 11
StaticLoadSelection;1
TemperatureSelection;11;BothLoadAndInitial
SubcaseStart;2
LabelText;load 2, bare TEMPERATURE = 12
StaticLoadSelection;2
TemperatureSelection;12
SubcaseStart;3
LabelText;load 3, TEMPERATURE(LOAD) = 12, TEMPERATURE(MATERIAL) = 11
StaticLoadSelection;3
TemperatureSelection;12;TemperatureLoadPart
TemperatureSelection;11;MaterialTemperature
SubcaseStart;4
LabelText;load 4 at the reference temperature
StaticLoadSelection;4
TemperatureSelection;13;TemperatureLoadPart
SubcaseCombination;10
LabelText;SUBSEQ with two factors (aligned on the last two subcases)
SubcaseCombinationFactors;2.,-1.
SubcaseCombination;20
LabelText;SUBSEQ1 over subcases 1 and 4
SubcaseCombinationFactors1;1.,1.,1.,0.5,4.
OutputBlock;;Plot
SetDefinition;5;All;Except;4
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
