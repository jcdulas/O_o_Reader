# thermal expansion; load sets 1 to 4 and temperature sets 11 (uniform 120 C)
# and 12 (a gradient). Units: mm, N, tonne, C.
IsoMat;1;7.E+4;;0.33;2.7E-9;2.3E-5;20.
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.
