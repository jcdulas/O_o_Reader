[executive]
# ============================================================================
# O_o_Reader test model: frequency dependent materials (SOL 108)
#
# Covers:
#   - cards: MAT1F MAT2F MAT8F MAT9F PCOMPFQ (with MAT1 MAT2 MAT8 MAT9 PSHELL
#     PCOMP PSOLID TABLED1 RLOAD1 DAREA FREQ1)
#   - solution: SOL 108 (direct frequency response, 100 to 1000 Hz)
#   - outputs: complex displacements and element stresses (real/imaginary)
# Run notes:
#   - three cantilever strips of CQUAD4 (isotropic, anisotropic and laminate
#     shells) and a solid block, each shaken at its free end; the moduli and
#     the structural damping of the materials follow TABLED1 tables of the
#     frequency
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;108
[case]
TitleText;O_o_Reader test model: frequency dependent materials (SOL 108)
BulkEcho;None
SinglePointConstrSelection;1
DynamicLoadSelection;1
FreqSetSelection;2
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;unit harmonic forces at the free ends
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s, MPa. Every table has the frequency (Hz) as its
# X value.
#
# Strip 1: steel (MAT1) whose E, G, NU and GE are tables of the frequency
# (MAT1F: the three elastic constants all have a table, as they are tied).
IsoMat;1;2.1E+5;80769.;0.3;7.85E-9;;;0.02
IsoMatFreq;1;11;12;13;14
TableDynamic1;11;;;0.;2.1E+5;2.E+3;2.15E+5;EndTable
TableDynamic1;12;;;0.;80769.;2.E+3;82692.;EndTable
TableDynamic1;13;;;0.;0.3;2.E+3;0.3;EndTable
TableDynamic1;14;;;0.;0.02;2.E+3;0.03;EndTable
ShellProp;1;1;1.;1;;1
Node;101;;0.;0.;0.
Node;102;;10.;0.;0.
Node;103;;20.;0.;0.
Node;104;;30.;0.;0.
Node;105;;40.;0.;0.
Node;106;;0.;10.;0.
Node;107;;10.;10.;0.
Node;108;;20.;10.;0.
Node;109;;30.;10.;0.
Node;110;;40.;10.;0.
ShellQuad4;101;1;101;102;107;106
ShellQuad4;102;1;102;103;108;107
ShellQuad4;103;1;103;104;109;108
ShellQuad4;104;1;104;105;110;109
SinglePointConstrList;1;123456;101;106
DynamicLoadScale;10;105;3;1.;110;3;1.
# Strip 2: the same steel as a shell anisotropic material (MAT2) whose G11,
# G22, G33 and GE are tables of the frequency (MAT2F).
AnisoMat2D;2;230769.;69231.;;230769.;;80769.;7.85E-9;;;;;0.02
AnisoMat2DFreq;2;21;;;21;;22;23
TableDynamic1;21;;;0.;230769.;2.E+3;236264.;EndTable
TableDynamic1;22;;;0.;80769.;2.E+3;82692.;EndTable
TableDynamic1;23;;;0.;0.02;2.E+3;0.03;EndTable
ShellProp;2;2;1.;2
Node;201;;0.;20.;0.
Node;202;;10.;20.;0.
