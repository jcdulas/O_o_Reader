# Temperatures: 20 degrees at the start, 60 degrees during the step.
DefaultTemperatureLoad;1;20.
DefaultTemperatureLoad;2;60.
# One step in 10 fixed increments.
NonlinearStepControl;10;1.;;FixedStepping;10
