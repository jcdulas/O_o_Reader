[executive]
# ============================================================================
# O_o_Reader test model: laminates with failure data and a gasket (SOL 400)
#
# Covers:
#   - cards: PCOMPG PCOMPF MATF MATTF MATS8 MATCB PCOMPLS MATG MATTG (with
#     MAT8 MATORT MAT1 TABL3D0 TABLES1 TABLEM1 TEMPD NLSTEP)
#   - solution: SOL 400 (nonlinear static, one step)
#   - outputs: displacements, SPC forces, ply stresses and strains of the
#     shell laminates, nonlinear stresses
# Run notes:
#   - two shell laminate strips and two layered solids in tension, a gasket
#     in compression; the temperature goes from 20 to 60 degrees
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader test model: laminates with failure data and a gasket
BulkEcho;None
SinglePointConstrSelection;1
TemperatureSelection;1;InitialTemperature
SubcaseStart;1
LabelText;tension of the laminates, compression of the gasket
AnalysisKind;NonlinearStatics
NonlinearStepSelection;10
StaticLoadSelection;1
TemperatureSelection;2;TemperatureLoadPart
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
StrainOutput;All;PlotOnly
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s, MPa.
#
# Strip 1: carbon/epoxy laminate with global ply IDs (PCOMPG), failure
# indices from the maximum stress criterion (MATF) whose fibre tensile
# strength drops with the temperature (MATTF), conventional integration
# through the thickness asked by PCOMPF.
OrthoMat2D;10;1.35E+5;9.E+3;0.3;5.E+3;5.E+3;3500.;1.6E-9;0.;3.E-5;20.
FailureMat;10;0;Criterion;1;1500.;1200.;50.;200.;50.;200.;70.;70.;70.
FailureMatTemperature;10;;12;1;103
TableMaterial1;103;;;20.;1500.;100.;1400.;EndTable
CompPropGlobal;10;;;;;20.;;;1001;10;0.25;0.;Yes;;1002;10;0.25;90.;Yes;;1003;10;0.25;90.;Yes;;1004;10;0.25;0.;Yes
CompPropIntegration;1;10;20
Node;101;;0.;0.;0.
Node;102;;10.;0.;0.
Node;103;;20.;0.;0.
Node;104;;30.;0.;0.
Node;105;;40.;0.;0.
Node;106;;0.;10.;0.
Node;107;;10.;10.;0.
Node;108;;20.;10.;0.
Node;109;;30.;10.;0.
Node;110;;40.;10.;0.
ShellQuad4;101;10;101;102;107;106
ShellQuad4;102;10;102;103;108;107
ShellQuad4;103;10;103;104;109;108
ShellQuad4;104;10;104;105;110;109
SinglePointConstrList;1;123456;101;106
PointForceLoad;1;105;;1.E+3;1.;0.;0.
PointForceLoad;1;110;;1.E+3;1.;0.;0.
# Strip 2: the same laminate whose fibre modulus depends on the local strain
# (MATS8 names a TABL3D0 of independent variable type 73).
OrthoMat2D;20;1.35E+5;9.E+3;0.3;5.E+3;5.E+3;3500.;1.6E-9;0.;3.E-5;20.
OrthoMat2DStressDependent;20;201
TableMultiVariable0;201;73;;;;;-0.01;1.3E+5;0.;1.35E+5;0.01;1.4E+5
CompPropGlobal;20;;;;;20.;;;2001;20;0.25;0.;Yes;;2002;20;0.25;90.;Yes;;2003;20;0.25;90.;Yes;;2004;20;0.25;0.;Yes
Node;201;;0.;20.;0.
Node;202;;10.;20.;0.
Node;203;;20.;20.;0.
Node;204;;30.;20.;0.
Node;205;;40.;20.;0.
Node;206;;0.;30.;0.
Node;207;;10.;30.;0.
Node;208;;20.;30.;0.
Node;209;;30.;30.;0.
Node;210;;40.;30.;0.
