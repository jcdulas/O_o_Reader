Node;406;;10.;60.;10.;;456
Node;407;;10.;70.;10.;;456
Node;408;;0.;70.;10.;;456
SolidHexa;400;30;401;402;403;404;405;406;407;408
SinglePointConstrList;1;123;401
SinglePointConstrList;1;23;402
SinglePointConstrList;1;3;403
SinglePointConstrList;1;13;404
