[executive]
# ============================================================================
# O_o_Reader test model: solid composites in a linear static run (SOL 101)
#
# Covers:
#   - cards: TABLE3D PCOMPLS MATF MATORT (with CORD3G MAT9 PSOLID CHEXA)
#   - solution: SOL 101 (linear static)
#   - outputs: displacements, SPC forces
# Run notes:
#   - block 1: an anisotropic solid whose material axes turn about Z with
#     the position (CORD3G of three TABLE3D angle tables, in radians)
#   - block 2: a layered solid with the failure indices of the maximum
#     stress criterion
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: solid composites (SOL 101)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
StrainOutput;All;PlotOnly
SubcaseStart;1
LabelText;tension of the two blocks
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s, MPa. Each block is a 10 mm cube (one CHEXA) held on
# its base so that it can expand freely in its plane, pulled along Z by four
# forces of 250 N on its top face.
#
# Block 1: carbon/epoxy as a MAT9 (fibres along the X axis of the material
# system). The material system is a CORD3G: its first Euler angle (about Z)
# goes from 0 at Y = 0 to 15 degrees at Y = 10; the two others are zero.
AnisoMat3D;1;137755.;4592.;4592.;;;;10867.;4439.;;;;10867.;;;;5.E+3;;;3200.;;5.E+3;1.6E-9
GeneralFrame3;100;EulerAngles313;Table;111;112;113;0
TableScattered3D;111;;;;;0.;0.;5.;0.;10.;0.;5.;0.;0.;10.;5.;0.2618;10.;10.;5.;0.2618;EndTable
TableScattered3D;112;;;;;0.;0.;5.;0.;10.;0.;5.;0.;0.;10.;5.;0.;10.;10.;5.;0.;EndTable
TableScattered3D;113;;;;;0.;0.;5.;0.;10.;0.;5.;0.;0.;10.;5.;0.;10.;10.;5.;0.;EndTable
SolidProp;1;1;100
Node;101;;0.;0.;0.;;456
Node;102;;10.;0.;0.;;456
Node;103;;10.;10.;0.;;456
Node;104;;0.;10.;0.;;456
Node;105;;0.;0.;10.;;456
Node;106;;10.;0.;10.;;456
Node;107;;10.;10.;10.;;456
Node;108;;0.;10.;10.;;456
SolidHexa;100;1;101;102;103;104;105;106;107;108
SinglePointConstrList;1;123;101
SinglePointConstrList;1;23;102
SinglePointConstrList;1;3;103
SinglePointConstrList;1;13;104
PointForceLoad;1;105;;250.;0.;0.;1.
PointForceLoad;1;106;;250.;0.;0.;1.
PointForceLoad;1;107;;250.;0.;0.;1.
PointForceLoad;1;108;;250.;0.;0.;1.
# Block 2: a layered solid (PCOMPLS, two plies at 0 and 90 degrees stacked
# along the element T direction) of an orthotropic material with failure
# data (MATF, maximum stress criterion, failure indices only).
OrthoMat3DNonlinear;2;1.35E+5;9.E+3;9.E+3;0.3;0.4;0.02;1.6E-9;5.E+3;3200.;5.E+3
FailureMat;2;0;Criterion;1;1500.;1200.;50.;200.;50.;200.;70.;70.;70.
CompSolidPropNonlinear;2;1;0;;;;2001;2;0.5;0.;;2002;2;0.5;90.
Node;201;;30.;0.;0.;;456
Node;202;;40.;0.;0.;;456
Node;203;;40.;10.;0.;;456
Node;204;;30.;10.;0.;;456
Node;205;;30.;0.;10.;;456
Node;206;;40.;0.;10.;;456
Node;207;;40.;10.;10.;;456
Node;208;;30.;10.;10.;;456
SolidHexa;200;2;201;202;203;204;205;206;207;208
SinglePointConstrList;1;123;201
SinglePointConstrList;1;23;202
SinglePointConstrList;1;3;203
SinglePointConstrList;1;13;204
PointForceLoad;1;205;;250.;0.;0.;1.
PointForceLoad;1;206;;250.;0.;0.;1.
PointForceLoad;1;207;;250.;0.;0.;1.
PointForceLoad;1;208;;250.;0.;0.;1.
