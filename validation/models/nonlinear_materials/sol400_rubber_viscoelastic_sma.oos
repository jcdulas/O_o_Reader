[executive]
# ============================================================================
# O_o_Reader test model: rubber, viscoelastic and shape memory solids (SOL 400)
#
# Covers:
#   - cards: MATHE MATTHE MATVE MATTVE MATSMA (with MAT1 TABLEM1 TEMPD NLSTEP)
#   - solution: SOL 400 (nonlinear static, large displacements, one step of
#     1 s so that the Prony terms relax)
#   - outputs: displacements, SPC forces, nonlinear stresses and strains
# Run notes:
#   - three one-element blocks side by side; the temperature goes from 20 to
#     40 degrees during the step
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;rubber, viscoelastic and shape memory solids
BulkEcho;None
SinglePointConstrSelection;1
TemperatureSelection;1;InitialTemperature
SubcaseStart;1
LabelText;tension at 40 degrees over 1 s
AnalysisKind;NonlinearStatics
NonlinearStepSelection;10
StaticLoadSelection;1
TemperatureSelection;2;TemperatureLoadPart
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
StrainOutput;All;PlotOnly
NonlinearStressOutput;All;PlotOnly
[model]
Parameter;PostprocessingFile;-1
Parameter;LargeDisplacements;1
# Units: mm, N, tonne, s, MPa. Each block is a 10 mm cube (one CHEXA) held on
# its base so that it can expand freely in its plane, pulled along Z by four
# forces on its top face.
#
# Block 1: a Mooney-Rivlin rubber (MATHE) whose constants depend on the
# temperature (MATTHE), with a one-term viscoelastic Prony series (MATVE
# MOONEY1) shifted in time by the temperature (MATTVE, WLF form).
HyperelasticMat;1;MooneyRivlin;600.;1.1E-9;2.E-4;20.;;0.5;0.1
HyperelasticMatTemperature;1;MooneyRivlin;;;;;101;102
TableMaterial1;101;;;20.;0.5;100.;0.45;EndTable
TableMaterial1;102;;;20.;0.1;100.;0.09;EndTable
ViscoElasticMat;1;MooneyRivlinModel1;;;0.3;0.1
ViscoElasticMatTemperature;1;WilliamsLandelFerry;20.;;;;;;17.44;51.6
SolidProp;1;1
Node;101;;0.;0.;0.;;456
Node;102;;10.;0.;0.;;456
Node;103;;10.;10.;0.;;456
Node;104;;0.;10.;0.;;456
Node;105;;0.;0.;10.;;456
Node;106;;10.;0.;10.;;456
Node;107;;10.;10.;10.;;456
Node;108;;0.;10.;10.;;456
SolidHexa;100;1;101;102;103;104;105;106;107;108
SinglePointConstrList;1;123;101
SinglePointConstrList;1;23;102
SinglePointConstrList;1;3;103
SinglePointConstrList;1;13;104
PointForceLoad;1;105;;12.5;0.;0.;1.
PointForceLoad;1;106;;12.5;0.;0.;1.
PointForceLoad;1;107;;12.5;0.;0.;1.
PointForceLoad;1;108;;12.5;0.;0.;1.
# Block 2: a polymer (MAT1) with a viscoelastic shear relaxation term (MATVE
# ISO1, one Prony term).
IsoMat;2;3.E+3;;0.35;1.2E-9;7.E-5;20.
ViscoElasticMat;2;IsotropicForm1;;;500.;0.2
SolidProp;2;2
Node;201;;30.;0.;0.;;456
Node;202;;40.;0.;0.;;456
Node;203;;40.;10.;0.;;456
Node;204;;30.;10.;0.;;456
Node;205;;30.;0.;10.;;456
Node;206;;40.;0.;10.;;456
Node;207;;40.;10.;10.;;456
Node;208;;30.;10.;10.;;456
SolidHexa;200;2;201;202;203;204;205;206;207;208
SinglePointConstrList;1;123;201
SinglePointConstrList;1;23;202
SinglePointConstrList;1;3;203
SinglePointConstrList;1;13;204
PointForceLoad;1;205;;500.;0.;0.;1.
PointForceLoad;1;206;;500.;0.;0.;1.
PointForceLoad;1;207;;500.;0.;0.;1.
PointForceLoad;1;208;;500.;0.;0.;1.
# Block 3: a nickel-titanium shape memory alloy (MATSMA, mechanical model),
# loaded below the start of the austenite to martensite transformation.
ShapeMemoryMat;3;1;20.;0.05;5.E+4;0.33;1.E-5;1.E+20;6.45E-9;520.;600.;8.66;5.E+4;0.33;1.E-5;1.E+20;6.45E-9;300.;200.;6.66
SolidProp;3;3
Node;301;;60.;0.;0.;;456
Node;302;;70.;0.;0.;;456
Node;303;;70.;10.;0.;;456
Node;304;;60.;10.;0.;;456
Node;305;;60.;0.;10.;;456
Node;306;;70.;0.;10.;;456
Node;307;;70.;10.;10.;;456
Node;308;;60.;10.;10.;;456
SolidHexa;300;3;301;302;303;304;305;306;307;308
SinglePointConstrList;1;123;301
SinglePointConstrList;1;23;302
SinglePointConstrList;1;3;303
SinglePointConstrList;1;13;304
PointForceLoad;1;305;;7500.;0.;0.;1.
PointForceLoad;1;306;;7500.;0.;0.;1.
PointForceLoad;1;307;;7500.;0.;0.;1.
PointForceLoad;1;308;;7500.;0.;0.;1.
# Temperatures: 20 degrees at the start, 40 degrees during the step.
DefaultTemperatureLoad;1;20.
DefaultTemperatureLoad;2;40.
# One step of 1 s in 10 fixed increments.
NonlinearStepControl;10;1.;;FixedStepping;10
