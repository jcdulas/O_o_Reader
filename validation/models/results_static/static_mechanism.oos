[executive]
# ============================================================================
# O_o_Reader validation deck: mechanism shapes (statics)
#
# Validates:
#   - how the solver writes the potential mechanism shapes in the OUTPUT2 file and the HDF5
#     file
#   - EPSILON and the external work of a run with a mechanism (listing)
# Settles (library item: current status):
#   - the kind 'mechanism_shapes' has no
#     decoder and no file layout (no-file-layout in both writers): the first
#     file that shows one
#   - the named results 'epsilon' and 'external_work' (made in memory only):
#     their listing values
# Run notes:
#   - the run is expected to end with the mechanism messages (BAILOUT -1 keeps
#     it going); bring back the listing even if the OUTPUT2 file holds no mechanism table
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: mechanism shapes
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
AppliedLoadOutput;All;PlotOnly
SubcaseStart;1
LabelText;in-plane loads on a plate free to turn about its hinge
[model]
# Output files: the OUTPUT2 file (PARAM,POST,-1, with the geometry) and the HDF5
# database in double precision with the deflate (GZIP) filter.
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# A plate of 2 x 2 CQUAD4 hinged on one edge about its own line (only
# translations held): a rigid rotation about the hinge line is a mechanism.
# AUTOSPC is off so that the decomposition finds it, BAILOUT lets the run go
# on, MECHOUT (default YES) writes the mechanism shapes.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.;;6
Node;2;;10.;0.;0.;;6
Node;3;;20.;0.;0.;;6
Node;4;;0.;10.;0.;;6
Node;5;;10.;10.;0.;;6
Node;6;;20.;10.;0.;;6
Node;7;;0.;20.;0.;;6
Node;8;;10.;20.;0.;;6
Node;9;;20.;20.;0.;;6
ShellQuad4;1;1;1;2;5;4
ShellQuad4;2;1;2;3;6;5
ShellQuad4;3;1;4;5;8;7
ShellQuad4;4;1;5;6;9;8
SinglePointConstrList;1;123;1;4;7
PointForceLoad;1;3;;1.;10.;0.;0.
PointForceLoad;1;9;;1.;10.;0.;0.
Parameter;AutoSingularityConstr;No
Parameter;SingularityBailOut;-1
Parameter;MechanismOutput;Yes
