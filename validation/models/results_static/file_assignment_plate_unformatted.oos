[executive]
# ============================================================================
# O_o_Reader validation model: unformatted file-assignment metadata
#
# Exercises native executive records with a file unit and form, case selections,
# and a plate under a tip load. The named external file is retained as metadata.
# Written for this project, to exercise native model reading and writing.
# See validation/models/README.md for the validation workflow.
# ============================================================================
FileAssignment;RESULTS='file_assignment_plate_unformatted.data';FileUnit=12;FileForm=Unformatted
SolutionSequence;101
