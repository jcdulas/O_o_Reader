[executive]
# ============================================================================
# O_o_Reader validation deck: ply columns, failure indices and strength ratios of laminates
#
# Validates:
#   - the last column of a ply table under STRESS(VONMISES) and under
#     STRESS(MAXS) (subcases 1 and 2)
#   - the failure indices (OEFIT) of CQUAD4 and CTRIA3 laminates for the four
#     theories, and the strength ratios (PARAM,SRCOMPS,YES: OESRT)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;laminate ply columns, failure indices, strength ratios
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
StrainOutput;All;PlotOnly;FiberDistance
SubcaseStart;1
LabelText;von Mises in the last column
StressOutput;All;PlotOnly;PrintListing;VonMisesStress
SubcaseStart;2
LabelText;maximum shear in the last column
StressOutput;All;PlotOnly;PrintListing;MaxShearStress
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Four laminated plates, one failure theory each (HILL, HOFF, TSAI, STRN),
# CQUAD4 and CTRIA3.
OrthoMat2D;2;1.35E+5;9.E+3;0.3;5.E+3;5.E+3;3500.;1.6E-9;-3.E-7;2.8E-5;20.;1500.;1200.;50.;200.;80.;0.01
OrthoMat2D;3;1.35E+5;9.E+3;0.3;5.E+3;5.E+3;3500.;1.6E-9;-3.E-7;2.8E-5;20.;0.011;0.009;0.006;0.02;0.012;0.01;;1.
CompProp;10;;;60.;Hill;20.;;;2;0.25;0.;Yes;2;0.25;45.;Yes;2;0.25;-45.;Yes;2;0.25;90.;Yes
