[executive]
# ============================================================================
# O_o_Reader validation deck: PLOAD4 forms and their resultants
#
# Validates:
#   - the applied loads (OLOAD) and the SPC forces of each PLOAD4 form:
#     uniform, corner pressures on a warped quadrilateral, a direction by CID
#     and N1-N3, a solid face (CHEXA, CTETRA)
# Settles (library item: current status):
#   - a PLOAD4 whose resultant the library does not reproduce (not
#     investigated)
#   - the load resultants of loads_table against the solver's OLOAD
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: PLOAD4 forms
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly;PrintListing
AppliedLoadOutput;All;PlotOnly;PrintListing
NodeForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;PLOAD4 forms
[model]
# Output files: the OUTPUT2 file (PARAM,POST,-1, with the geometry) and the HDF5
# database in double precision with the deflate (GZIP) filter.
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# PLOAD4 in each of its forms on single elements: uniform, four corner
# pressures, a direction given by CID and N1-N3 (SORL/LDIR left blank), the
# THRU form, and on a face of a CHEXA and of a CTETRA.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
SolidProp;2;1
RectFrame2;5;;0.;0.;0.;0.;0.;1.;1.;1.;0.
Node;101;;0.;0.;0.
Node;102;;10.;0.;0.5
Node;103;;12.;9.;1.
Node;104;;-1.;11.;1.5
ShellQuad4;101;1;101;102;103;104
SinglePointConstrList;1;123456;101;102
Node;201;;0.;100.;0.
Node;202;;10.;100.;0.5
Node;203;;12.;109.;1.
Node;204;;-1.;111.;1.5
ShellQuad4;201;1;201;202;203;204
SinglePointConstrList;1;123456;201;202
Node;301;;0.;200.;0.
Node;302;;10.;200.;0.5
Node;303;;12.;209.;1.
Node;304;;-1.;211.;1.5
ShellQuad4;301;1;301;302;303;304
SinglePointConstrList;1;123456;301;302
