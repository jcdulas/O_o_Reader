Node;402;;10.;300.;0.5
Node;403;;12.;309.;1.
Node;404;;-1.;311.;1.5
ShellQuad4;401;1;401;402;403;404
SinglePointConstrList;1;123456;401;402
FacePressureLoad;1;101;0.1
FacePressureLoad;1;201;0.1;0.2;0.3;0.4
FacePressureLoad;1;301;0.1;;;;;;5;0.3;0.4;0.5
FacePressureLoad;1;401;-0.1;-0.15;-0.2;-0.25
Node;501;;0.;500.;0.;;456
Node;502;;10.;500.;0.;;456
Node;503;;10.;510.;0.;;456
Node;504;;0.;510.;0.;;456
Node;505;;0.;500.;10.;;456
Node;506;;10.;500.;10.;;456
Node;507;;10.;510.;10.;;456
Node;508;;0.;510.;10.;;456
SolidHexa;501;2;501;502;503;504;505;506;507;508
SinglePointConstrList;1;123;501;502;503;504
FacePressureLoad;1;501;1.;2.;3.;4.;505;507
