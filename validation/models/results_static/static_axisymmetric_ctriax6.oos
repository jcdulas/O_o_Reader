[executive]
# ============================================================================
# O_o_Reader validation deck: axisymmetric CTRIAX6 (statics)
#
# Validates:
#   - the real SORT1 stress, strain and force tables of CTRIAX6 (element type
#     53)
#   - the mass of a ring element in the grid point weight (per radian or over
#     360 degrees)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: CTRIAX6 statics
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
AppliedLoadOutput;All;PlotOnly
StressOutput;All;PlotOnly
StrainOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
NodeForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;axial pull and radial load
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Include;ctriax6_model.oos
Parameter;WeightReferenceNode;0
