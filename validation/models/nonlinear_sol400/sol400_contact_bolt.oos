[executive]
# ============================================================================
# O_o_Reader validation deck: contact tractions and bolt results (SOL 400)
#
# Validates:
#   - the contact forces and tractions of a touching contact (BCONTACT,
#     BOUTPUT) and the bolt results (BOLT with a preload on its control grid
#     point), 32-bit OUTPUT2 and HDF5
# Settles (library item: current status):
#   - contact_tractions real SORT1 and bolt_results real
#     SORT1 32-bit (not_validated: the bolt tables are validated in 64-bit
#     files only)
#   - the contact and bolt datasets of the HDF5 file (no
#     decoder: never observed)
# Run notes:
#   - run it also with the i8 executable for the 64-bit twin of the bolt
#     tables
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader validation: contact and bolt (SOL 400)
BulkEcho;Sorted
SinglePointConstrSelection;1
ContactSelection;21
SubcaseStart;1
LabelText;pressure on the upper block, bolt preload
AnalysisKind;NonlinearStatics
StaticLoadSelection;1
NonlinearStaticParamsSelection;10
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
SlidelineContactOutput;All;PlotOnly
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Two blocks of 2 x 2 x 1 CHEXA in contact (the upper one pressed on the lower
# one, separate grid points on the interface) and a bolt shank of two CHEXA
# cut at mid height (BOLT: the grid points of the cut, top and bottom, and the
# control grid point 999 where the preload is applied). Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
SolidProp;1;1
SolidProp;2;1
SolidProp;3;1
Node;101;;0.;0.;0.;;456
