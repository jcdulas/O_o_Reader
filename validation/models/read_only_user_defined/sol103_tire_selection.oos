[executive]
# ============================================================================
# O_o_Reader test model: external tire model selection (SOL 103, read-only)
#
# Covers:
#   - cards: TIRE
#   - solution: SOL 103 (normal modes of a simple vehicle frame on its four
#     tires)
#   - outputs: none (not run)
# Run notes:
#   - read-only: TIRE names tire models of an external tire library; their
#     stiffness comes from that library and from the DTI entries it exports
#     for each tire, which need the library and tire data the project does
#     not have
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader test model: tire selection (read-only)
BulkEcho;Sorted
TireSelectionRequest;100
EigenMethodSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;modes of the frame on its tires
[model]
Parameter;PostprocessingFile;-1
LanczosEigenMethod;1;;;6
# The four tires: front left, front right, rear left, rear right.
TireSelection;100;ExternalTireModel;WHEELFL;WHEELFR;WHEELRL;WHEELRR
# A steel ladder frame 2500 x 1500 mm of CBAR tubes with a 400 kg body mass
# at its centre (RBE3 to the corners); the wheel hubs are its corners.
# Units: mm, N, t, s.
IsoMat;1;2.1E+5;;0.3;7.85E-9
BarShapeProp;1;1;;Tube;40.;35.
Node;1;;0.;0.;0.
Node;2;;2500.;0.;0.
Node;3;;2500.;1500.;0.
Node;4;;0.;1500.;0.
Node;5;;1250.;750.;0.
Bar2;1;1;1;2;0.;;0.;1.
Bar2;2;1;2;3;0.;;0.;1.
Bar2;3;1;3;4;0.;;0.;1.
Bar2;4;1;4;1;0.;;0.;1.
RigidInterpolation;5;5;123456;1;1.;123;4;1;2;3;4
PointMassInertia;6;5;;0.4
