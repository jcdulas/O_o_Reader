[executive]
# ============================================================================
# O_o_Reader test model: user subroutines and user defined services (SOL 400, read-only)
#
# Covers:
#   - cards: MATUDS MATUSR MATTUSR UDSESV BCONUDS ELEMUDS GENUDS
#   - solution: SOL 400 (nonlinear static contact of two blocks whose
#     materials, friction and a bearing element are user code)
#   - outputs: none (not run)
# Run notes:
#   - read-only: every entry of the list calls user code (HYPELA2 and UMAT
#     material routines, a UFRIC friction routine, a PBUSH2D element routine
#     and a runtime notify service) built into a shared library with the SCA
#     build tools and named on the CONNECT SERVICE statements; none ships
#     with the solver
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader test model: user services (read-only)
BulkEcho;Sorted
SinglePointConstrSelection;1
ContactSelection;21
SubcaseStart;1
LabelText;upper block pressed on the lower one
AnalysisKind;NonlinearStatics
StaticLoadSelection;1
NonlinearStaticParamsSelection;10
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
[model]
Parameter;PostprocessingFile;-1
NonlinearStaticParams;10;5
# Materials are user routines: MATUSR 1 (hypoelastic law, HYPELA2, its
# density and expansion vary with temperature through MATTUSR) and MATUSR 2
# (UMAT with two state variables besides the temperature, UDSESV). Units:
# mm, N, t, s, MPa.
UserMat;1;0;1;2.7E-9;2.3E-5;;;20.
UserMatTable;1;31;32
TableMaterial1;31;;;20.;2.7E-9;200.;2.68E-9;EndTable
TableMaterial1;32;;;20.;2.3E-5;200.;2.5E-5;EndTable
UserMatService;1;UserMat;MATERIAL;HYPELA2;RealBlock;2;7.E+4;0.33
UserMat;2;0;1;7.85E-9;1.2E-5;;;20.
UserMatService;2;UserMat;MATERIAL;UMAT;RealBlock;3;2.1E+5;0.3;355.;IntegerBlock;1;2
UserStateVariables;3;SV2;EQPLAS;SV3;DAMAGE
SolidProp;1;1
SolidProp;2;2
# Lower block (PSOLID 2) 20 x 20 x 10 mm, upper block (PSOLID 1) on top with
# its own grid points on the interface: 2 x 2 x 1 CHEXA each.
Node;101;;0.;0.;0.;;456
Node;102;;10.;0.;0.;;456
Node;103;;20.;0.;0.;;456
Node;104;;0.;10.;0.;;456
Node;105;;10.;10.;0.;;456
Node;106;;20.;10.;0.;;456
Node;107;;0.;20.;0.;;456
Node;108;;10.;20.;0.;;456
Node;109;;20.;20.;0.;;456
Node;110;;0.;0.;10.;;456
Node;111;;10.;0.;10.;;456
Node;112;;20.;0.;10.;;456
Node;113;;0.;10.;10.;;456
Node;114;;10.;10.;10.;;456
Node;115;;20.;10.;10.;;456
Node;116;;0.;20.;10.;;456
Node;117;;10.;20.;10.;;456
Node;118;;20.;20.;10.;;456
SolidHexa;101;2;101;102;105;104;110;111;114;113
SolidHexa;102;2;102;103;106;105;111;112;115;114
SolidHexa;103;2;104;105;108;107;113;114;117;116
SolidHexa;104;2;105;106;109;108;114;115;118;117
Node;201;;0.;0.;10.;;456
Node;202;;10.;0.;10.;;456
Node;203;;20.;0.;10.;;456
Node;204;;0.;10.;10.;;456
Node;205;;10.;10.;10.;;456
Node;206;;20.;10.;10.;;456
Node;207;;0.;20.;10.;;456
Node;208;;10.;20.;10.;;456
Node;209;;20.;20.;10.;;456
Node;210;;0.;0.;20.;;456
Node;211;;10.;0.;20.;;456
Node;212;;20.;0.;20.;;456
Node;213;;0.;10.;20.;;456
Node;214;;10.;10.;20.;;456
Node;215;;20.;10.;20.;;456
Node;216;;0.;20.;20.;;456
Node;217;;10.;20.;20.;;456
Node;218;;20.;20.;20.;;456
SolidHexa;201;1;201;202;205;204;210;211;214;213
SolidHexa;202;1;202;203;206;205;211;212;215;214
SolidHexa;203;1;204;205;208;207;213;214;217;216
SolidHexa;204;1;205;206;209;208;214;215;218;217
SinglePointConstrList;1;123;101;102;103;104;105;106;108;109
SinglePointConstrList;1;12;210;211;212;213;214;215;217;218
# Pressure of 5 MPa on the top face of the upper block.
FacePressureLoad;1;201;5.;;;;210;214
FacePressureLoad;1;202;5.;;;;211;215
FacePressureLoad;1;203;5.;;;;213;217
FacePressureLoad;1;204;5.;;;;214;218
# Contact: the two blocks are deformable bodies; the friction of the upper
# body comes from the UFRIC routine (base coefficient 0.2).
ContactPropertyRegion;11;1
ContactPropertyRegion;12;2
ContactBody1;1;;ThreeDimensional;Deformable;11
ContactBody1;2;;ThreeDimensional;Deformable;12
ContactPair;21;;;1;2
ContactUserService;1;ContactBody;CONTACT;UFRIC;RealData;1;0.2
# A bearing in the XY plane between the lower corner of the upper block
# (grid point 201) and a coincident ground point: PBUSH2D 50 gives its
# nominal stiffness and damping, the element routine of ELEMUDS its
# frequency dependence.
Node;902;;0.;0.;10.
SinglePointConstrList;1;123456;902
Bushing2D;50;50;201;902;;PlaneXy
BushProp2D;50;1.E+5;1.E+5;10.;10.
UserElemService;50;BushProp2D;ELEMENT;UBEAR;Frequency;60.;RealBlock;2;0.05;0.01
# Runtime data passed to the notify service at each increment.
UserServiceData;NOTIFY;IntegerBlock;2;1;10;TextBlock;1;LOG
