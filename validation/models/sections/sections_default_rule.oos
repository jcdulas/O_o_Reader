[executive]
# ============================================================================
# O_o_Reader validation deck: beam library sections under the solver's default finite element formulation (SOL 101)
#
# Validates:
#   - the PBAR and PBEAM the solver writes in the EPT table of the result data for every
#     PBARL and PBEAML type (area, I1, I2, J, K1, K2, the stress points), the
#     element forces and stresses of a known tip load
# Run notes:
#   - PARAM,POST,-1 writes the EPT records of the result data (the PBAR and PBEAM
#     the solver derives)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: beam library sections
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip loads
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;WeightReferenceNode;0
Include;sections_model.oos
