[executive]
# ============================================================================
# O_o_Reader test model: nonlinear 3D bushing load, continuation (SOL 128)
#
# Covers:
#   - cards: NLBSH3D, LBSH3DG, NLFREQC, NHRMPRM, NLHARM
#   - solution: SOL 128 (nonlinear harmonic response with the improved
#     continuation procedure, CONTP = 2)
#   - outputs: displacements (harmonic response per frequency)
# Run notes:
#   - no rotor is defined: the speed that LBSH3DG interpolates on is the
#     forcing frequency (synchronous case); the tables cover 100 to 800 Hz
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;128
[case]
TitleText;nonlinear bushing load, continuation (SOL 128)
BulkEcho;None
SinglePointConstrSelection;1
EigenMethodSelection;1
DynamicLoadSelection;200
NonlinearLoadSelection;100
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;continuation from 300 Hz up to 600 Hz, through the first modes
NonlinearHarmonicSelection;40
[model]
Parameter;PostprocessingFile;-1
# Grids 1 and 2 at the origin, each on a CBUSH (six stiffnesses) to its own
# fixed ground point, with mass and inertia: all six components of both are
# in the solution set, as NLBSH3D needs. Units: mm, N, t, s.
Node;1;;0.;0.;0.
Node;2;;0.;0.;0.
Node;11;;0.;0.;0.
Node;12;;0.;0.;0.
SinglePointConstrList;1;123456;11;12
PointMassInertia;1;1;;0.001;;;;0.01;;0.01;;;0.01
PointMassInertia;2;2;;0.002;;;;0.02;;0.02;;;0.02
Bushing;11;11;1;11;;;;;0
Bushing;12;12;2;12;;;;;0
BushProp;11;Stiffness;1.E+4;1.E+4;1.E+4;1.E+5;1.E+5;1.E+5;Damping;1.;1.;1.;1.;1.;1.
BushProp;12;Stiffness;5.E+4;5.E+4;5.E+4;5.E+5;5.E+5;5.E+5;Damping;2.;2.;2.;2.;2.;2.
# Excitation: 100 N along x on grid 1, flat in frequency
DynamicLoadScale;300;1;1;100.
FreqResponseLoad1;200;300;;;;;400
TableDynamic1;400;;;0.;1.;2.E+3;1.;EndTable
# The nonlinear load between grids 1 and 2: force against relative
# displacement along T1 and T2 (LBSH3DG 21, diagonal terms) and against
# relative velocity (LBSH3DG 22, symmetric form, lower triangle); each
# TABLED5 gives a TABLED1 for each of two speeds
NonlinearBushLoad3D;100;1;2;21;22
NonlinearBushForceTables;21;DiagonalForm;100.;800.;501;502
NonlinearBushForceTables;22;SymmetricForm;100.;800.;511;;;;;;;512
TableDynamic5;501;100.;601;800.;602;EndTable
TableDynamic5;502;100.;601;800.;602;EndTable
TableDynamic5;511;100.;611;800.;611;EndTable
TableDynamic5;512;100.;611;800.;611;EndTable
TableDynamic1;601;;;-0.2;-3.E+3;-0.1;-1.E+3;0.;0.;0.1;1.E+3;0.2;3.E+3;EndTable
TableDynamic1;602;;;-0.2;-4.E+3;-0.1;-1200.;0.;0.;0.1;1200.;0.2;4.E+3;EndTable
TableDynamic1;611;;;-100.;-50.;100.;50.;EndTable
# Three harmonics; the frequencies come from the continuation procedure
# (NHRMPRM CONTP = 2, QR decomposition) of NLFREQC 30, with an output
# every 10 Hz; the first modes are near 500 Hz
NonlinearHarmonicParams;40;;3;30
NonlinearHarmonicFreqContinuation;30;300.;1.;;;400;250.;600.;0.001;No;DefaultOutput;10.;5.;300.;600.
NonlinearHarmonicSolverParams;ContinuationMethod;2;DecompositionMethod;QrDecomposition;StepHalvingIterations;8
LanczosEigenMethod;1;;3.E+3;4
