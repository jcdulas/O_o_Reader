[executive]
# ============================================================================
# O_o_Reader test model: axisymmetric conical shell, free modes
#
# Covers:
#   - cards: SUPAX (with AXIC, RINGAX, CCONEAX, PCONEAX, MAT1, EIGRL)
#   - solution: SOL 103 (real eigenvalues, Lanczos)
#   - outputs: eigenvalues, eigenvectors of the ring harmonics (OUTPUT2)
# Run notes:
#   - the cone is free: SUPAX puts in the r-set the axial and circumferential
#     components of harmonic 0 (axial translation, torsion) and the radial and
#     axial components of harmonic 1 (lateral translation, tilt) at ring 1
#   - HARMONICS = ALL asks the output of every harmonic
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader test model: axisymmetric conical shell, free modes
BulkEcho;Sorted
HarmonicsSelection;All
EigenMethodSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;free-free modes
[model]
Parameter;PostprocessingFile;-1
LanczosEigenMethod;1;;;10
# Units: mm, N, tonne, s, degrees C. Steel (MAT1 1, with an expansion
# coefficient and TREF 20 C). AXIC 2: harmonics 0, 1 and 2.
AxisymConeControl;2
IsoMat;1;2.1E+5;;0.3;7.85E-9;1.2E-5;20.
# A truncated cone 100 mm high, radius 100 at z = 0 to 60 at z = 100: five
# RINGAX, four CCONEAX on PCONEAX 1 (2 mm: membrane, bending and transverse
# shear, stresses at 0 and 90 degrees).
AxisymConeRing;1;100.;0.
AxisymConeRing;2;90.;25.
AxisymConeRing;3;80.;50.
AxisymConeRing;4;70.;75.
AxisymConeRing;5;60.;100.
ConicalShellProp;1;1;2.;1;0.6667;1;1.6667;;1.;-1.;0.;90.
ShellConical2;1;1;1;2
ShellConical2;2;1;2;3
ShellConical2;3;1;3;4
ShellConical2;4;1;4;5
# Determinate supports of the free cone (ring, harmonic, components).
AxisymConeSupport;1;0;23;1;1;13
