[executive]
# ============================================================================
# O_o_Reader validation deck: quadratic solids, lumped mass and default
# integration (SOL 101)
#
# Validates:
#   - the lumped mass the solver puts on the grid points of a distorted CHEXA (20
#     nodes) and a distorted CPENTA (15 nodes) under GRAV with PARAM COUPMASS
#     at its default (the applied loads, OLOAD, of subcase 1 are the masses
#     times the acceleration): the corners and the mid-side points
#   - the stresses at the corners and the centre of the same elements under a
#     force (subcase 2), PSOLID IN and ISOP blank: the default integration of
#     each (the CHEXA 3 x 3 x 3 with reduced shear, the CPENTA)
# Settles (library item: current status):
#   - a companion package: the lumped mass of the quadratic solids (one box observed:
#     no mass on the CHEXA corners and M(S/3 + L^2)/(8S) on its mid-side
#     points; HRZ kept until a second shape) and the default integration of
#     the CPENTA (15 nodes)
# Run notes:
#   - PARAM,GRDPNT,0 prints the grid point weight (the total mass to compare)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;quadratic solids: lumped mass and default integration
BulkEcho;Sorted
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
AppliedLoadOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;gravity: the lumped masses
StaticLoadSelection;1
SubcaseStart;2
LabelText;a force on the top corners: the stresses
StaticLoadSelection;2
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
Parameter;WeightReferenceNode;0
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# A CHEXA (grid points 101 to 120) and a CPENTA (201 to 215), apart, both
# distorted (the corners out of a box, some mid-side points off their straight
# edges), clamped on their bottom faces. Steel; units: mm, N, tonne.
IsoMat;1;2.1E+5;;0.3;7.85E-9
SolidProp;1;1
GravityLoad;1;;9810.;0.;0.;-1.
PointForceLoad;2;105;;100.;1.;0.;0.
PointForceLoad;2;107;;100.;0.;1.;0.
PointForceLoad;2;204;;100.;1.;0.;0.
PointForceLoad;2;206;;100.;0.;1.;0.
Node;101;;0.;0.;0.
Node;102;;20.;0.;0.
Node;103;;22.;18.;0.
Node;104;;-2.;20.;0.
Node;105;;1.;1.;25.
Node;106;;19.;2.;24.
Node;107;;21.;19.;26.
Node;108;;0.;21.;23.
Node;109;;10.;-0.8;0.
Node;110;;21.;9.;0.
Node;111;;10.;19.;0.
Node;112;;-1.;10.;0.
Node;113;;0.5;0.5;12.5
Node;114;;20.2;1.;12.
Node;115;;21.5;18.5;13.
Node;116;;-1.;20.5;11.5
Node;117;;10.;1.5;24.5
Node;118;;20.6;10.5;25.5
Node;119;;10.5;20.;24.5
Node;120;;0.5;11.;24.
Node;201;;50.;0.;0.
Node;202;;72.;2.;0.
Node;203;;58.;20.;0.
Node;204;;51.;1.;22.
Node;205;;70.;3.;25.
Node;206;;59.;19.;24.
Node;207;;61.;1.;0.
Node;208;;65.8;11.5;0.
Node;209;;54.;10.;0.
Node;210;;50.5;0.5;11.
Node;211;;71.6;2.5;12.5
Node;212;;58.5;19.5;12.
Node;213;;60.5;2.;23.5
Node;214;;64.5;11.;25.2
Node;215;;55.;10.;23.
SolidHexa;1;1;101;102;103;104;105;106;107;108;109;110;111;112;113;114;115;116;117;118;119;120
SolidPenta;2;1;201;202;203;204;205;206;207;208;209;210;211;212;213;214;215
SinglePointConstrList;1;123456;101;102;103;104;109;110;111;112
