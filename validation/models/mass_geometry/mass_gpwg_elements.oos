[executive]
# ============================================================================
# O_o_Reader validation deck: element masses and the grid point weight (SOL 103)
#
# Validates:
#   - the solver's grid point weight (OGPWG and the listing print) and element summary
#     (ELSUM) for elements whose mass the library computes by a rule of its
#     own: CBAR and CBEAM with offsets, CBEAM3 with an off-centre mid node,
#     CBEND GEOM 1 to 4, distorted solids with mid-side nodes, an oblique
#     CPYRAM, CMASS1 and CMASS2 on scalar points and on component 5
# Settles (library item: current status):
#   - the mass (CBAR length between the offset ends, CBEAM3 arc length and
#     centre, CBEND mass not computed, the solids with mid-side nodes, CMASS
#     on scalar points or rotations: confirmed against independent
#     computations only)
#   - the geometry (CBEAM3 length, area, volume; CBEND length)
#   - the model mass against the grid point weight (not investigated)
# Run notes:
#   - the elements are free: the modes include rigid-body modes; only the grid
#     point weight and the element summary are wanted
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader validation: element masses and grid point weight
BulkEcho;Sorted
EigenMethodSelection;1
ElemSummaryOutput;All;Both
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;grid point weight
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;WeightReferenceNode;0
# One element of each kind whose mass the library computes by a rule the solver's
# grid point weight confirms: CBAR and CBEAM with end offsets, CBEAM3 with a
# mid-node off centre, CBEND in its four GEOM forms, distorted CHEXA (20
# nodes), CTETRA (10), CPENTA (15), an oblique CPYRAM, CMASS1 and CMASS2 on
# scalar points and on component 5. Each element is free (no SPC): the run is
# a modal analysis whose grid point weight (PARAM,GRDPNT,0) and element
# summary (ELSUM) are the reference. Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
BarProp;1;1;20.;40.;30.;50.;0.001
BeamProp;2;1;20.;40.;30.;0.;50.;0.001
