[executive]
# ============================================================================
# O_o_Reader validation deck: element geometry checks of distorted quadrilaterals (SOL 101)
#
# Validates:
#   - the solver's taper and warping measures of CQUAD4, CQUADR, CQUAD8 and CSHEAR
#     (GEOMCHECK with limits so low that every element is reported, as
#     information)
# Run notes:
#   - the listing lists each element with its measured value: bring the listing back
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
GeometryCheck;QuadTaperLimit=0.001;QuadWarpLimit=0.0001;QuadSkewLimit=89.0;QuadMinAngle=89.0;QuadMaxAngle=91.0
GeometryCheck;MessageKind=INFORM;MessageLimit=1000
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: geometry checks
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;distorted quadrilaterals
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Distorted quadrilaterals (CQUAD4, CQUADR, CQUAD8, CSHEAR): a tapered one and
# a warped one of each, every test limit of GEOMCHECK set very low so that the
# listing prints the solver's measure of each. Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
ShearPanelProp;2;1;2.
Node;101;;0.;20.;0.
Node;102;;10.;20.;0.
Node;103;;8.;26.;0.
Node;104;;1.;30.;0.
ShellQuad4;1;1;101;102;103;104
