[executive]
# ============================================================================
# O_o_Reader test model: legacy surface contact sets (read-only)
#
# Covers:
#   - cards: BCTSET, BCTPARM, BCTPARA, BCTADD
#   - solution: SOL 101 (linear static with surface contact, as the decks
#     that carry these entries use it)
#   - outputs: none (not run)
# Run notes:
#   - READ-ONLY: the four entries are not in the format
#     reference (they are entries of another implementation, with the BCSET
#     case command); the solver would stop on them. O_o_Reader
#     reads, checks and writes them; this deck is not run
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: legacy surface contact sets (read-only)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
ContactSetSelection;200
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;two plates pressed on a base plate
[model]
Parameter;PostprocessingFile;-1
# A base plate (PSHELL 1, 2 x 2 CQUAD4, clamped edges) and two small plates
# resting on it (PSHELL 2 and 3, one CQUAD4 each), 1 mm thick, their mid
# planes 1 mm apart. Units: mm, N, t.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;1;1;1.;1;;1
ShellProp;2;1;1.;1;;1
ShellProp;3;1;1.;1;;1
