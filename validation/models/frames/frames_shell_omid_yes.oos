[executive]
# ============================================================================
# O_o_Reader validation deck: shell results in the material system, PARAM,OMID,YES (SOL 101)
#
# Validates:
#   - the stresses, strains and forces of CQUAD4, CTRIA3, CTRIAR and CQUAD8
#     with THETA and MCID written with PARAM,OMID,YES
#   - the same results without OMID come from the other deck of the pair
# Settles (library item: current status):
#   - PARAM,OMID,YES (the format's word; no file with shells that have a THETA
#     and an OUTPUT2 file) and 'a run with both forms (BOTH) is refused': the first
#     pair of runs settles it
#   - the shellStress, shellStrain and shellForce rows element <-> material
#     of the convention table (validated by analysis only)
# Run notes:
#   - run frames_shell_omid_yes.bdf also with the PARAM,OMID line removed
#     (subfolder omid_no) for the standard-form twin
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: shell results with PARAM,OMID,YES
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly;PrintListing
StrainOutput;All;PlotOnly;PrintListing;FiberDistance
ElemForceOutput;All;PlotOnly;PrintListing
SubcaseStart;1
LabelText;in-plane and bending tip loads
[model]
# Output files: OUTPUT2 (PARAM,POST,-1) and the HDF5 database (double precision,
# deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;OutputMaterialFrame;Yes
Include;frames_shell_model.oos
