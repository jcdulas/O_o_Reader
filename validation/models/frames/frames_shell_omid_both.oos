[executive]
# ============================================================================
# O_o_Reader validation deck: shell results in the material system, PARAM,OMID,BOTH (SOL 101)
#
# Validates:
#   - the stresses, strains and forces of CQUAD4, CTRIA3, CTRIAR and CQUAD8
#     with THETA and MCID written with PARAM,OMID,BOTH (the result data and HDF5 files
#     hold both the standard form and the material form of the same results)
#   - the same results without OMID come from the other deck of the pair
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: shell results with PARAM,OMID,BOTH
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly;PrintListing
StrainOutput;All;PlotOnly;PrintListing;FiberDistance
ElemForceOutput;All;PlotOnly;PrintListing
SubcaseStart;1
LabelText;in-plane and bending tip loads
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;OutputMaterialFrame;Both
Include;frames_shell_model.oos
