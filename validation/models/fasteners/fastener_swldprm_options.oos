[executive]
# ============================================================================
# O_o_Reader validation deck: fastener search parameters (SWLDPRM) (SOL 101)
#
# Validates:
#   - the piercing points the solver finds with MOVGAB 1, GSPROJ, GSMOVE,
#     PROJTOL 0.05, ACTVTOL, GMCHK, DRATIO, NREDIA and GSTOL: the generated
#     grid points in GEOM1, the PRTSW print
# Run notes:
#   - a connector that the solver cannot place is reported in the listing; the run
#     continues (CHKRUN 0)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: SWLDPRM options
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip loads on the upper plate
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Two parallel plates 2 mm apart (PSHELL 41 lower clamped at x = 0, PSHELL 42
# upper), 4 x 4 CQUAD4 each, connected by CFAST and CWELD whose search depends
# on the SWLDPRM parameters below. Units: mm, N, tonne.
