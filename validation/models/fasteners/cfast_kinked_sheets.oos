[executive]
# ============================================================================
# O_o_Reader validation deck: CFAST piercing points near a fold between non-coplanar shells (SOL 101)
#
# Validates:
#   - which element a CFAST located near the fold between two shells that are
#     not coplanar pierces: the generated grid points (GEOM1), the PRTSW print
# Settles (library item: current status):
#   - the element pierced near an edge between two elements that are not
#     coplanar
# Run notes:
#   - SWLDPRM PRTSW 1 prints the projected points
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: fastener piercing points near a fold
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
NodeForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip load on the upper sheet
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Two sheets each folded 20 degrees along the line x = 20 (lower PSHELL 51, z
# = 0 then rising; upper PSHELL 52, 2 mm above along the normal), 4 x 2 CQUAD4
# each, and CFAST (D = 4) located less than 1.8 mm from the fold line.
# Units: mm, N, tonne.
