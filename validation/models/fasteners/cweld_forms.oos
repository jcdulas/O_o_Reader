[executive]
# ============================================================================
# O_o_Reader validation deck: CWELD connection forms on linear and quadratic shells (SOL 101)
#
# Validates:
#   - the piercing points (generated grid points) for each CWELD form (GEOM1
#     of PARAM,POST,-1): PARTPAT, ELEMID with two shells,
#     ELEMID point to patch, GRIDID QQ on CQUAD4 and on CQUAD8 (mid-side
#     nodes), GRIDID TT on CTRIA6, GRIDID point to patch, ALIGN, a second
#     ELPAT and PARTPAT (the numbering after the first connector), PWELD TYPE
#     SPOT
#   - the weld forces and stresses (FORCE, STRESS)
# Settles (library item: current status):
#   - the piercing points of CWELD PARTPAT (taken as CFAST PROP), ELEMID,
#     GRIDID, point to patch; CQUAD8, CTRIA6 and GRIDID shapes with mid-side
#     nodes; the length of a SPOT weld; the generated IDs beyond the first
#     connector
#   - the stress/strain/forces tables of cweld (not_validated)
# Run notes:
#   - SWLDPRM PRTSW 1 prints the projections in the listing: bring the listing back
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: CWELD forms
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
NodeForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip loads on the upper plates
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Two pairs of parallel plates 2 mm apart (units mm, N, tonne). Pair 1: linear
# shells, lower plate PSHELL 11 (4 x 4 CQUAD4, z = 0, clamped at x = 0), upper
# plate PSHELL 12 (4 x 4 CQUAD4, z = 2). Pair 2: quadratic shells at y = 100,
# lower 2 CQUAD8 and 2 CTRIA6 (PSHELL 13), upper the same (PSHELL 14).
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;11;1;1.5;1;;1
ShellProp;12;1;1.5;1;;1
ShellProp;13;1;1.5;1;;1
