[executive]
# ============================================================================
# O_o_Reader validation deck: CFAST forms (SOL 101)
#
# Validates:
#   - the piercing points (generated grid points) of CFAST ELEM located by GS,
#     by XS YS ZS, with GA given and GB blank, on a warped CQUAD4, on CQUAD8
#     and CTRIA6 shells; the fastener frame of PFAST MFLAG 1 and of a
#     cylindrical MCID
#   - the fastener forces (FORCE) in the element system each PFAST defines
# Run notes:
#   - SWLDPRM PRTSW 1 prints the projections in the listing
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader validation: CFAST forms
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
ElemStrainEnergyOutput;All;PlotOnly
SubcaseStart;1
LabelText;tip loads on the upper plates
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
