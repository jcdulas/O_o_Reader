[executive]
# ============================================================================
# O_o_Reader test model: flow boundaries of an Euler channel (SOL 700)
#
# Covers:
#   - cards: FLOW FLOWT FLOWC FLOWDEF MESH PEULER1 MATDEUL EOSGAM EOSPOL
#     TICEUL1 TICREG SPHERE (with TLOAD1 of type 4)
#   - solution: SOL 700 (explicit transient: water and air in a multi-material
#     Euler channel with no structure; inflow, outflow, cyclic side
#     boundaries)
#   - outputs: none that O_o_Reader decodes (the explicit solver writes its
#     own result files)
# Run notes:
#   - DLOAD = 1 selects FLOW 1, FLOWT 2 and FLOWC 3 and 4 through TLOAD1
#     entries of type 4 whose TID is blank (format reference: TLOAD1 remark 12, FLOW
#     remark 3, FLOWT and FLOWC remark 2)
#   - needs the explicit solver of SOL 700 in the installation
#   - units mm, t, s, MPa
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;700;NonlinearTransient
[case]
TitleText;flow boundaries of an Euler channel (SOL 700)
BulkEcho;None
StepEndTime;0.01
NonlinearTimeStepSelection;1
DynamicLoadSelection;1
[model]
# Time: 100 steps of 1.0E-4 s (10 ms), output every 10 steps
NonlinearTimeSteps;1;100;1.E-4;10
# ---------------------------------------------------------------- Euler mesh
# A 400 x 100 x 100 mm channel along X, 25 mm cells
EulerMeshGenerator;1;Box;;;;;;;0.;0.;0.;400.;100.;100.;16;4;4;;;;Euler;10
EulerRegionProp;10;MultiMaterialHydrodynamic;20
# Air (ideal gas) and water (polynomial, bulk modulus 2200 MPa)
EulerMat;11;1.2E-12;1
GammaLawStateEquation;1;1.4;2.87E+8
EulerMat;12;1.E-9;2
PolynomialStateEquation;2;2200.
# Air everywhere, water in the lower half (Z below 50)
EulerInitialRegions;20;21
InitialConditionRegion;1;21;Sphere;31;11;81;0.
InitialConditionRegion;2;21;Box;32;12;82;1.
SphereShape;31;200.;50.;50.;500.
ContactBoxRegion;32;;Coordinates;0;;0.;;0.;;0.;;400.;;0.;;0.;;400.;100.;0.;0.;100.;0.;0.;0.;50.;400.;0.;50.;400.;100.;50.;0.;100.;50.
InitialConditionValues;81;;Density;1.2E-12;SpecificInternalEnergy;2.083E+11
InitialConditionValues;82;;Density;1.E-9
# ---------------------------------------------------------------- boundaries
# -X face: water flows in at 1 m/s
EulerFlowBoundary;1;;;NegativeXDirection;;;;;;;Material;12;VelocityX;1.E+3;Density;1.E-9;SpecificInternalEnergy;0.;Flow;In
# +X face: outflow with the values of the adjacent elements
EulerTimeFlowBoundary;2;;Out;;PositiveXDirection
# -Y and +Y faces: cyclic, what leaves one side enters the other (velocity
# and material mapped, element pressures)
EulerCyclicFlowBoundary;3;;Both;;NegativeYDirection;4;;;;;;;2
EulerCyclicFlowBoundary;4;;Both;;PositiveYDirection;3;;;;;;;2
# The other free faces (-Z, +Z): outflow only
EulerDefaultFlowBoundary;5;MultiMaterialHydrodynamic;Flow;Out
# DLOAD = 1 selects the boundaries: one TLOAD1 of type 4 (a flow boundary)
# with a blank TID for each of FLOW 1, FLOWT 2 and FLOWC 3 and 4
TransientTableLoad1;1;1;;;4
TransientTableLoad1;1;2;;;4
TransientTableLoad1;1;3;;;4
TransientTableLoad1;1;4;;;4
