[executive]
# ============================================================================
# O_o_Reader test model: water tank with hydrostatic preset (SOL 700)
#
# Covers:
#   - cards: PEULER1 EOSPOL PMINC HYDSTAT PORHYDS EULFOR1 EULFREG COUPLE
#     LEAKAGE MESH MATDEUL EOSGAM TICEUL1 TICREG SPHERE CYLINDR
#   - solution: SOL 700 (explicit transient: water and air in a multi-material
#     Euler mesh, coupled to a closed steel tank; gravity, an opening to the
#     sea, a sideways acceleration of the water)
#   - outputs: none that O_o_Reader decodes (the explicit solver writes its
#     own result files)
# Run notes:
#   - needs the explicit solver of SOL 700 in the installation (SOL 700 spawns
#     it; a sol700.pth file or the default path must locate it)
#   - units mm, t, s, MPa; water bulk modulus 2200 MPa, gravity 9810 mm/s2
#   - the free surface is at Z = 100 mm, inside the tank and outside (the sea)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;700;NonlinearTransient
[case]
TitleText;water tank with hydrostatic preset (SOL 700)
BulkEcho;None
StepEndTime;0.02
NonlinearTimeStepSelection;1
SinglePointConstrSelection;1
DynamicLoadSelection;1
[model]
# Time: 200 steps of 1.0E-4 s (20 ms), output every 20 steps
NonlinearTimeSteps;1;200;1.E-4;20
