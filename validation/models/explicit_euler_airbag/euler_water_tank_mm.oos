# Gravity on everything (structure and Euler), constant in time
GravityLoad;1;;9810.;0.;0.;-1.
TransientTableLoad1;1;1;;;0;60
TableDynamic1;60;;;0.;1.;1.;1.;EndTable
# ---------------------------------------------------------------- Euler mesh
# 9 x 5 x 9 hexahedra of 25 mm around the tank (no Euler plane on a wall)
EulerMeshGenerator;1;Box;;;;;;;-12.5;-12.5;-12.5;225.;125.;225.;9;5;9;;;;Euler;10
# Multi-material: initial regions (TICEUL1 20), region forces (EULFOR1 30)
EulerRegionProp;10;MultiMaterialHydrodynamic;20;30
# Air (ideal gas) and water (polynomial: bulk modulus, cavitation at -0.1 MPa)
EulerMat;11;1.2E-12;1
GammaLawStateEquation;1;1.4;2.87E+8
EulerMat;12;1.E-9;2;;;;1
PolynomialStateEquation;2;2200.
ConstantSpallation;1;-0.1
# Air everywhere, water below Z = 100 (a box region)
EulerInitialRegions;20;21
InitialConditionRegion;1;21;Sphere;31;11;81;0.
InitialConditionRegion;2;21;Box;32;12;82;1.
SphereShape;31;100.;50.;100.;400.
ContactBoxRegion;32;;Coordinates;0;;-12.5;;-12.5;;-12.5;;212.5;;-12.5;;-12.5;;212.5;112.5;-12.5;-12.5;112.5;-12.5;-12.5;-12.5;100.;212.5;-12.5;100.;212.5;112.5;100.;-12.5;112.5;100.
InitialConditionValues;81;;Density;1.2E-12;SpecificInternalEnergy;2.083E+11
InitialConditionValues;82;;Density;1.E-9
# The water densities follow the hydrostatic pressure under the free surface
# at Z = 100 (atmospheric pressure 0.1 MPa above it)
EulerHydrostaticPreset;1;12;;;100.;50.;100.;0.1
# A sideways acceleration pulse on the water inside a cylinder around the tank
EulerBodyForceSet;30;31
EulerForceRegion;1;31;Cylinder;33;12;61;62;62
CylinderShape;33;100.;50.;-50.;100.;50.;250.;300.
TableDynamic1;61;;;0.;0.;0.005;2.E+3;0.01;0.;1.;0.;EndTable
TableDynamic1;62;;;0.;0.;1.;0.;EndTable
# ---------------------------------------------------------------- coupling
# The tank holds the Euler materials (COVER = OUTSIDE); hydrostatic preset 1
ContactPropertyRegion;101;1
EulerLagrangeCoupling;1;101;Outside;On;On;11;;;;;;;;;;;;;1
# An opening low in the +X wall (Z 0 to 50, under water): the sea outside,
# at the hydrostatic pressure of HYDSTAT 1
ContactElemSurface;201;1101;Through;1108
GasBagLeakage;1;11;201;PorousHydrostaticBoundary;1
PorousHydrostaticBoundary;1
