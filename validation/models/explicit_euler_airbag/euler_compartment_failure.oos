[executive]
# ============================================================================
# O_o_Reader test model: two compartments with failing walls (SOL 700)
#
# Covers:
#   - cards: COUP1FL COUPINT COUPLE MESH PEULER1 MATDEUL EOSGAM TICEUL1 TICREG
#     SPHERE (with MATF, SOL 700 form, and MATEP)
#   - solution: SOL 700 (explicit transient: a gas explosion in one of two
#     steel compartments, each with its own multi-material Euler mesh; the
#     walls may fail and open the compartments to each other and to the air)
#   - outputs: none that O_o_Reader decodes (the explicit solver writes its
#     own result files)
# Run notes:
#   - COUP1FL and COUPINT act with DYPARAM,FASTCOUP,,FAIL, which needs a
#     failure model on the material of the shells (format reference: DYPARAM,FASTCOUP
#     remark 3, COUP1FL and COUPINT remark 1): the SOL 700 form of MATF with
#     criterion 103 (maximum plastic strain)
#   - needs the explicit solver of SOL 700 in the installation
#   - units mm, t, s, MPa
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;700;NonlinearTransient
[case]
TitleText;two compartments with failing walls (SOL 700)
BulkEcho;None
StepEndTime;0.002
NonlinearTimeStepSelection;1
SinglePointConstrSelection;1
[model]
# Time: 200 steps of 1.0E-5 s (2 ms), output every 20 steps
NonlinearTimeSteps;1;200;1.E-5;20
# Fast coupling with failure of the coupling surfaces; gas flow between the
# two Euler domains across the facets that open
ExplicitParam;FastCoupling;InPlaneMesh;FailureCriterion
ExplicitParam;FlowMethod;PolynomialPacking
# ---------------------------------------------------------------- structure
# Two 100 mm compartments along X, 1 mm steel with plasticity (yield 250 MPa,
# hardening 1000 MPa), 4 x 4 shells per face: compartment 1 (PSHELL 1), the
# shared wall (PSHELL 3), compartment 2 (PSHELL 2); held at Z = -50
IsoMat;1;2.1E+5;;0.3;7.85E-9
ElastoPlasticMat;1;Slope;250.;;VonMises;;1.E+3
# The failure model of the shells: maximum plastic strain 0.05 (MATF, SOL 700
# form, criterion 103)
FailureMat;1;;Criterion;103;0.05
ShellProp;1;1;1.;1;;1
ShellProp;2;1;1.;1;;1
ShellProp;3;1;1.;1;;1
