# ---------------------------------------------------------------- Euler gas
# One 6 x 6 x 6 Euler mesh of 20 mm cells per compartment
EulerMeshGenerator;1;Box;;;;;;;-110.;-60.;-60.;120.;120.;120.;6;6;6;;;;Euler;10
EulerMeshGenerator;2;Box;;;;;;;-10.;-60.;-60.;120.;120.;120.;6;6;6;;;;Euler;10
EulerRegionProp;10;MultiMaterialHydrodynamic;20
# Air, and the products of the gas explosion (ideal gas, gamma 1.3)
EulerMat;11;1.2E-12;1
GammaLawStateEquation;1;1.4;2.87E+8
EulerMat;12;1.2E-12;2
GammaLawStateEquation;2;1.3
# Air everywhere; a sphere of products at 3 MPa in compartment 1
EulerInitialRegions;20;21
InitialConditionRegion;1;21;Sphere;31;11;81;0.
InitialConditionRegion;2;21;Sphere;32;12;82;1.
SphereShape;31;0.;0.;0.;500.
SphereShape;32;-50.;0.;0.;30.
InitialConditionValues;81;;Density;1.2E-12;SpecificInternalEnergy;2.083E+11
InitialConditionValues;82;;Density;1.E-11;SpecificInternalEnergy;1.E+12
# ---------------------------------------------------------------- coupling
# Each compartment holds its gas (COVER = OUTSIDE) in its own Euler mesh;
# where a wall fails, the gas meets the surroundings of COUP1FL 1
ContactPropertyRegion;101;1;3
ContactPropertyRegion;102;2;3
EulerLagrangeCoupling;1;101;Outside;On;On;;;;;;;;;;;1;;1
EulerLagrangeCoupling;2;102;Outside;On;On;;;;;;;;;;;2;;1
# The surroundings: air at rest at 0.1 MPa
CouplingFailedSegmentFlow;1;1.2E-12;2.083E+11;0.;0.;0.;;11
# Where the shared wall fails, the two compartments exchange gas
CouplingInteraction;1;1;2
