[executive]
# ============================================================================
# O_o_Reader test model: air bag of three chambers (SOL 700)
#
# Covers:
#   - cards: GBAG GBAGCOU ABINFL INFLTR INFLHB INFLCG INFLTNK INFLGAS INFLFRC
#     INITGAS LEAKAGE PORHOLE PERMEAB PORFCPL PORFGBG PERMGBG HEATLOS HTRCONV
#     HTRRAD FFCONTR COUPLE MESH PEULER1 MATDEUL EOSGAM TICEUL1 TICREG SPHERE
#   - solution: SOL 700 (explicit transient: two Eulerian air bag chambers,
#     each with its own Euler mesh, and a uniform pressure chamber; a
#     fluid-filled bottle beside them)
#   - outputs: none that O_o_Reader decodes (the explicit solver writes its
#     own result files)
# Run notes:
#   - needs the explicit solver of SOL 700 in the installation (SOL 700 spawns
#     it; a sol700.pth file or the default path must locate it)
#   - units mm, t, s, MPa, K; the gases use R and cp in mm2/(s2 K)
#   - chamber 2 switches from Euler gas dynamics to uniform pressure (GBAGCOU)
#     once its pressure is uniform
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;700;NonlinearTransient
[case]
TitleText;O_o_Reader test model: air bag of three chambers (SOL 700)
BulkEcho;None
StepEndTime;0.005
NonlinearTimeStepSelection;1
SinglePointConstrSelection;1
[model]
# Time: 500 steps of 1.0E-5 s (5 ms), output every 50 steps
NonlinearTimeSteps;1;500;1.E-5;50
# Gas flow between the two Euler domains across the open bulkhead facets
ExplicitParam;FlowMethod;PolynomialPacking
# ---------------------------------------------------------------- structure
# Three 100 mm chambers in a row along X, 1 mm aluminium, 4 x 4 shells per
# face: chamber 1 (PSHELL 1), the bulkhead between 1 and 2 (PSHELL 3),
# chamber 2 (PSHELL 2), the wall between 2 and 3 (PSHELL 4), chamber 3
# (PSHELL 5). The bottle (PSHELL 6) stands apart. All held at Z = -50.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;1.;1;;1
ShellProp;2;1;1.;1;;1
ShellProp;3;1;1.;1;;1
ShellProp;4;1;1.;1;;1
ShellProp;5;1;1.;1;;1
ShellProp;6;1;1.;1;;1
