ContactElemSurface;210;5506
# ---------------------------------------------------------------- Euler gas
# Each Eulerian chamber has its own 6 x 6 x 6 Euler mesh of 20 mm cells
EulerMeshGenerator;1;Box;;;;;;;-110.;-60.;-60.;120.;120.;120.;6;6;6;;;;Euler;10
EulerMeshGenerator;2;Box;;;;;;;-10.;-60.;-60.;120.;120.;120.;6;6;6;;;;Euler;10
EulerRegionProp;10;Hydrodynamic;20
EulerMat;11;1.2E-12;1
GammaLawStateEquation;1;1.4;2.87E+8
# Ambient air in both meshes
EulerInitialRegions;20;21
InitialConditionRegion;1;21;Sphere;31;11;81;0.
SphereShape;31;0.;0.;0.;500.
InitialConditionValues;81;;Density;1.2E-12;SpecificInternalEnergy;2.083E+11
# ---------------------------------------------------------------- chambers
# Chamber 1: Eulerian air bag with two inflators, a vent, a permeable side,
# a hole to chamber 2, heat loss, an initial gas composition
EulerLagrangeCoupling;1;101;Outside;On;On;11;;AirbagCoupling;21;31;;;;41;;1
# Chamber 2: Eulerian air bag with two inflators, a hole and a permeable
# patch to chamber 3
EulerLagrangeCoupling;2;102;Outside;On;On;12;;AirbagCoupling;22;;;;;;;2
# The uniform pressure model of chamber 2, used after the switch
GasBag;2;102;;;12;22;;;Constant;1.005E+9;2.87E+8;0.1;On;On;;293.;293.
GasBagSwitch;1;2;2;0.002;5.
# Chamber 3: uniform pressure only, a vent, heat loss, an initial gas
# composition
GasBag;3;103;;;13;;32;41;Constant;1.005E+9;2.87E+8;0.1;On;On;;293.;293.
# ---------------------------------------------------------------- inflators
InflatorInlet;1;21;201;StandardInflator;1
InflatorInlet;2;21;202;HybridInflator;2;Constant;1.
InflatorInlet;3;22;206;ColdGasInflator;3
InflatorInlet;4;22;207;TankTestInflator;4
# A pyrotechnic inflator: mass flow (TABLED1 72), 600 K, gamma 1.4 and R
StandardInflator;1;72;;600.;;1.4;;2.87E+8
# A hybrid inflator: mass flow (TABLED1 71), 500 K, nitrogen and argon in
# the fractions of INFLFRC 61
HybridInflator;2;71;;500.;61;51;52
HybridInflatorFractions;61;;TimeStep;0.;2;0.8;0.2;TimeStep;0.005;2;0.5;0.5
# A cold gas inflator: a 10 cm3 tank of air at 10 MPa and 293 K
ColdGasInflator;3;1.E+4;10.;293.;;;1.4;;2.87E+8
# A tank-test inflator (average temperature method): tank pressure TABLED1 73
TankTestInflator;4;AverageTemperatureMethod;73;2.E+6;1.7E-6;0.1;;;;1.4;;2.87E+8
# The gases: nitrogen, argon, air (specific gas constant, constant cp)
InflatorGas;51;ResponseSpectrum;2.968E+8;Constant;1.04E+9
InflatorGas;52;ResponseSpectrum;2.081E+8;Constant;5.2E+8
InflatorGas;53;ResponseSpectrum;2.87E+8;Constant;1.005E+9
# Chambers 1 and 3 start filled with air
InitialGasComposition;41;53;1.
# Mass flow rates (t/s) and the tank pressure (MPa) over time
TableDynamic1;71;;;0.;0.;5.E-4;2.E-4;0.004;2.E-4;0.005;0.;EndTable
TableDynamic1;72;;;0.;0.;5.E-4;2.E-4;0.004;2.E-4;0.005;0.;EndTable
TableDynamic1;73;;;0.;0.1;0.005;0.25;EndTable
# ---------------------------------------------------------------- leakage
# Chamber 1 (set 11): vent, permeable side, hole to chamber 2
GasBagLeakage;1;11;203;GasBagVentHole;1
GasBagLeakage;2;11;204;SurfacePermeability;2
GasBagLeakage;3;11;205;CouplingHoleToCoupling;3
# Chamber 2 (set 12): hole and permeable patch to chamber 3
GasBagLeakage;4;12;208;CouplingHoleToGasBag;4
GasBagLeakage;5;12;209;GasBagPermeableLink;5
# Chamber 3 (set 13): vent
GasBagLeakage;6;13;210;GasBagVentHole;1
# The environment: 0.1 MPa, 1.2E-12 t/mm3, its specific energy, cp
GasBagVentHole;1;Small;Both;0.1;1.2E-12;2.083E+11;1.005E+9
SurfacePermeability;2;1.E+3;;Out;0.1;1.2E-12;2.083E+11;1.005E+9
CouplingHoleToCoupling;3;Small;Both;2
CouplingHoleToGasBag;4;Small;Both;3
GasBagPermeableLink;5;1.E+3;;Both;3
# ---------------------------------------------------------------- heat loss
# Chamber 1 (set 31): convection and radiation over the whole surface;
# chamber 3 (set 32): convection
GasBagHeatTransfer;1;31;0;GasBagConvection;1
GasBagHeatTransfer;2;31;0;GasBagRadiation;2
GasBagHeatTransfer;3;32;0;GasBagConvection;1;Constant;1.
# 25 W/(m2 K) and the Stefan-Boltzmann constant, in t, mm, s, K
GasBagConvection;1;0.025;;293.
GasBagRadiation;2;0.15;;293.;5.67E-11
# ---------------------------------------------------------------- bottle
# A closed 1 L bottle holding 0.6 L of fluid under atmospheric pressure
FluidFilledContainer;1;104;6.E+5;0.1
