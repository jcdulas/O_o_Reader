[executive]
# ============================================================================
# O_o_Reader test model: Euler gas in a closed box with porosity (SOL 700)
#
# Covers:
#   - cards: MESH BIAS PEULER1 MATDEUL EOSGAM TICEUL1 TICREG SPHERE CYLINDR
#     SURFINI COUPLE COUOPT LEAKAGE PORHOLE PERMEAB PORFLOW PORFLWT COUCOHF
#     COHFRIC EULFOR
#   - solution: SOL 700 (explicit transient: an ideal gas in a single-material
#     Euler mesh, coupled to a closed shell box)
#   - outputs: none that O_o_Reader decodes (the explicit solver writes its
#     own result files)
# Run notes:
#   - needs the explicit solver of SOL 700 in the installation (SOL 700 spawns
#     it; a sol700.pth file or the default path must locate it)
#   - units mm, t, s, MPa; the gas is air (gamma 1.4, R 2.87E8 mm2/s2/K)
#   - the Euler mesh is generated by MESH; the gas is inside the box (COVER =
#     OUTSIDE)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;700;NonlinearTransient
[case]
TitleText;O_o_Reader test model: Euler gas in a closed box (SOL 700)
BulkEcho;None
StepEndTime;0.001
NonlinearTimeStepSelection;1
SinglePointConstrSelection;1
[model]
# Time: 100 steps of 1.0E-5 s (1 ms), output every 10 steps
NonlinearTimeSteps;1;100;1.E-5;10
# ---------------------------------------------------------------- structure
# The closed box: 100 mm cube, 1 mm aluminium, 4 x 4 shells per face,
# held at its bottom face
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;1.;1;;1
# A small closed surface that only sets the gas of a region (not coupled, fixed)
ShellProp;2;1;1.;1;;1
