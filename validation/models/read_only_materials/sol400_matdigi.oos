[executive]
# ============================================================================
# O_o_Reader test model: a material of an external micromechanics program (SOL 400, read-only)
#
# Covers:
#   - cards: MATDIGI (with UDNAME UDSESV PSOLID CHEXA NLSTEP)
#   - solution: SOL 400 (nonlinear static)
#   - outputs: none (read-only deck)
# Run notes:
#   - read-only: read and written by O_o_Reader, not run. A MATDIGI run
#     needs the material file named by the UDNAME (made with the
#     external micromechanics program, which this project does not author) and the
#     licence of that program
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader test model: a material of an external micromechanics program (read-only)
BulkEcho;None
SinglePointConstrSelection;1
SubcaseStart;1
AnalysisKind;NonlinearStatics
NonlinearStepSelection;10
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s, MPa. A glass fibre filled polyamide cube whose
# behaviour comes from a material of an external micromechanics program file, pulled along Z.
MicromechanicsCompositeMat;1;10;1.36E-9
UserFileName;10;pa66_gf30_micro.mat
UserStateVariables;30
SolidProp;1;1
Node;101;;0.;0.;0.;;456
Node;102;;10.;0.;0.;;456
Node;103;;10.;10.;0.;;456
Node;104;;0.;10.;0.;;456
Node;105;;0.;0.;10.;;456
Node;106;;10.;0.;10.;;456
Node;107;;10.;10.;10.;;456
Node;108;;0.;10.;10.;;456
SolidHexa;100;1;101;102;103;104;105;106;107;108
SinglePointConstrList;1;123;101
SinglePointConstrList;1;23;102
SinglePointConstrList;1;3;103
SinglePointConstrList;1;13;104
PointForceLoad;1;105;;250.;0.;0.;1.
PointForceLoad;1;106;;250.;0.;0.;1.
PointForceLoad;1;107;;250.;0.;0.;1.
PointForceLoad;1;108;;250.;0.;0.;1.
NonlinearStepControl;10;1.;;FixedStepping;10
