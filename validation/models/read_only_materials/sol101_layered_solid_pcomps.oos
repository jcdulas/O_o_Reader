[executive]
# ============================================================================
# O_o_Reader test model: a layered solid property PCOMPS of another implementation (read-only)
#
# Covers:
#   - cards: PCOMPS (with MAT1 CHEXA)
#   - solution: SOL 101 (linear static, the form of that implementation)
#   - outputs: none (read-only deck)
# Run notes:
#   - read-only: read and written by O_o_Reader, not run. PCOMPS is an entry
#     of another implementation: the format reference has no page for
#     it (the solver models layered solids with PCOMPLS)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: PCOMPS (read-only)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;tension of a layered solid
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s, MPa. A cube of two plies (aluminium and steel)
# stacked along Z (stacking direction 13), pulled along Z.
