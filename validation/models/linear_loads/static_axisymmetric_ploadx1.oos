[executive]
# ============================================================================
# O_o_Reader test model: pressure on an axisymmetric ring, PLOADX1 (SOL 101)
#
# Covers:
#   - cards: PLOADX1 (on CTRIAX6, constant and linearly varying traction,
#     normal and inclined)
#   - solution: SOL 101 (linear statics, 2 subcases)
#   - outputs: displacements, SPC forces, applied loads, CTRIAX6 stresses
# Run notes:
#   - the ring lies in the XZ plane of the basic system (r = x, z = z); the
#     tractions are integrated by the solver over the circumference
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: PLOADX1 on CTRIAX6
BulkEcho;Sorted
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
AppliedLoadOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;internal pressure on the inner face
StaticLoadSelection;1
SubcaseStart;2
LabelText;varying inclined traction on the outer face
StaticLoadSelection;2
[model]
Parameter;PostprocessingFile;-1
# Steel ring, inner radius 50, outer radius 60, height 10 (mm, N, t, s).
IsoMat;1;2.1E+5;;0.3;7.85E-9
# The CTRIAX6 has components 1 (radial) and 3 (axial) only.
Node;11;;50.;0.;0.;;2456
Node;12;;55.;0.;0.;;2456
Node;13;;60.;0.;0.;;2456
Node;14;;50.;0.;5.;;2456
Node;15;;55.;0.;5.;;2456
Node;16;;60.;0.;5.;;2456
Node;17;;50.;0.;10.;;2456
Node;18;;55.;0.;10.;;2456
Node;19;;60.;0.;10.;;2456
AxisymTria6;1;1;11;12;13;16;19;15
AxisymTria6;2;1;11;15;19;18;17;14
# Axial support of the bottom face; the hoop stiffness holds the ring
# radially.
SinglePointConstrList;1;3;11;12;13
# Load set 1: 2 MPa normal to the inner face (corner grid points 11, 17).
AxisymTractionLoad;1;2;2.;;11;17
# Load set 2: traction from 1 to .5 MPa on the outer face (corner grid points
# 13, 19), inclined by 30 degrees from the inward normal.
AxisymTractionLoad;2;1;1.;0.5;13;19;30.
