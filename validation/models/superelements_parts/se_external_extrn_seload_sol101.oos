[executive]
# ============================================================================
# O_o_Reader test model: external superelement joined by EXTRN, loaded by SELOAD
#
# Covers:
#   - cards: EXTRN, SELOAD, MPCY (with SEBULK EXTOP4, BEGIN SUPER)
#   - solution: SOL 101 (statics of a residual plate and an external
#     superelement read from an OP4 file)
#   - outputs: displacements, SPC forces, MPC forces
# Run notes:
#   - run op4_matrices/op4_extseout_sparse_binary.oos first: this deck reads
#     its OP4 file (../op4_matrices/op4_extseout_sparse_binary.op4)
#   - subcase 2 applies column 1 of the load matrix of the external
#     superelement (no LDLABEL in its creation run, hence COLNUM)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
FileAssignment;INPUTT4='../op4_matrices/op4_extseout_sparse_binary.op4';FileUnit=27;FileForm=Unformatted
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: external superelement, EXTRN and SELOAD
BulkEcho;None
SinglePointConstrSelection;1
MultiPointConstrSelection;70
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;load on the residual
StaticLoadSelection;1
SubcaseStart;2
LabelText;load of the external superelement
StaticLoadSelection;11
[model]
Parameter;PostprocessingFile;-1
# Residual structure: a plate of 4 x 2 CQUAD4 at x 0 to 40, y 0 to 20,
# clamped at x = 0; its edge x = 40 (points 5, 10, 15) meets the boundary of
# the external superelement 100. Units: mm, N, tonne, s.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.
Node;2;;10.;0.;0.
Node;3;;20.;0.;0.
Node;4;;30.;0.;0.
Node;5;;40.;0.;0.
Node;6;;0.;10.;0.
Node;7;;10.;10.;0.
Node;8;;20.;10.;0.
Node;9;;30.;10.;0.
Node;10;;40.;10.;0.
Node;11;;0.;20.;0.
Node;12;;10.;20.;0.
Node;13;;20.;20.;0.
Node;14;;30.;20.;0.
Node;15;;40.;20.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;1;2;3;8;7
ShellQuad4;3;1;3;4;9;8
ShellQuad4;4;1;4;5;10;9
ShellQuad4;5;1;6;7;12;11
ShellQuad4;6;1;7;8;13;12
ShellQuad4;7;1;8;9;14;13
ShellQuad4;8;1;9;10;15;14
SinglePointConstrList;1;123456;1;6;11
PointForceLoad;1;15;;10.;0.;0.;1.
# A relative deflection of 0.01 mm imposed between points 9 and 14.
MultiPointConstrWithValue;70;14;3;1.;0.01;9;3;-1.
# External superelement 100 (matrices on unit 27), found on the residual.
SuperelementBulkOptions;100;ExternalMatrixFile;;Automatic;;;27
# Load set 11: column 1 of the load matrix of superelement 100.
SuperelementLoadScale;11;1.;100;1.;ColumnNumber;1
[model;SuperelementPart;100]
# The boundary points of superelement 100 and the components its matrices
# connect to, in ascending point order.
Node;1001;;40.;0.;0.
Node;1004;;40.;10.;0.
Node;1007;;40.;20.;0.
SuperelementExternalBoundary;1001;123456;1004;123456;1007;123456
