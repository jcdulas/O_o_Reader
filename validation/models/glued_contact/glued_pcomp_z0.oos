[executive]
# ============================================================================
# O_o_Reader validation deck: glued shells on a laminate offset by Z0 (SOL 101)
#
# Validates:
#   - whether the solver's glued contact places the skins of a PCOMP on its plies:
#     Z0 is the distance from the grid plane to the bottom of the laminate
#     (format reference PCOMP), here 0, so the 4 mm laminate stands from z = 0 to z = 4
#     instead of -2 to 2
#   - body 2, a 2 mm PSHELL plate with its grid points at z = 5 (skins 4 and
#     6), rests on the real top of the laminate; body 3, a plate at z = -1
#     (skins -2 and 0), on its real bottom. The automatic ERROR is 0.5 (the
#     smallest edge 10 over 20, the thinnest shell 2 over 4) and BIAS 0: both
#     plates are glued when Z0 counts (gap 0), neither when the laminate is
#     taken centred on its grid plane (gap 2 and -2)
# Settles (library item: current status):
#   - the laminate's Z0 in the contact distance: the library's assumption
#     that it counts, not validated against
#     the solver; contactNodePairs(rule="solver") ties 7 grid points of the laminate
#     to the plates at gap 0 (the search from the lower body ID first,
#     ISEARCH 0), none when the laminate is taken centred
# Run notes:
#   - NLOPRM MPCPCH punches the glue equations (format reference BCTABLE remark 18): bring
#     the .pch back with the listing and the OUTPUT2 file
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;glued shells on a laminate offset by Z0
BulkEcho;Sorted
NonlinearOutputParams;PunchGlueEquations
ContactSelection;1
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;loads on the plates glued to the laminate
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Body 1: a 40 x 40 laminate of 4 x 4 CQUAD4 with its grid points at z = 0,
# two plies of 2 mm, Z0 = 0. Bodies 2 and 3: 20 x 20 plates of 2 x 2 CQUAD4,
# 2 mm thick, at z = 5 and z = -1. Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
OrthoMat2D;2;1.5E+5;1.E+4;0.3;5.E+3;5.E+3;5.E+3;1.6E-9
