[executive]
# ============================================================================
# O_o_Reader validation deck: glued shells with thickness, ZOFFS and BIAS (SOL 101)
#
# Validates:
#   - the grid points the solver glues between shells and the face, the local
#     coordinates and the gap of each (the MPC equations of the glue, punched
#     by NLOPRM MPCPCH, and the contact status printed in the listing)
#   - the shell thickness in the contact distance: plates whose skins touch
#     (the grid planes one thickness apart), a plate whose skins touch through
#     its offset ZOFFS, a plate 0.3 away from its skin with ERROR 0.5 and
#     BIAS 0.5 (glued if the zone is |gap| <= ERROR, not glued if BIAS biases
#     it to 0.25 outside)
#   - the automatic ERROR (no ERROR on the first two pairs: the smallest edge
#     over 20 and the thinnest shell over 4) and the double-order search
# Run notes:
#   - NLOPRM MPCPCH punches the glue equations (format reference BCTABLE remark 18): bring
#     the .pch back with the listing and the result data
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;glued shells with thickness, ZOFFS and BIAS
BulkEcho;Sorted
NonlinearOutputParams;PunchGlueEquations
ContactSelection;1
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;loads on the glued plates
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Body 1: a 40 x 40 plate of 4 x 4 CQUAD4 at z = 0, 2 mm thick (skins at -1
# and 1). Body 2: a 20 x 20 plate of 2 x 2 CQUAD4 at z = 2 over it (skins at 1
# and 3: they touch body 1). Body 3: a 20 x 20 plate under it, grid points at
# z = -5 with ZOFFS 3 (mid surface at -2, skins at -3 and -1: they touch).
# Body 4: a 10 x 10 plate of 1 CQUAD4 at z = 2.3 (its bottom skin 0.3 above
# body 1), with ERROR 0.5 and BIAS 0.5. Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
