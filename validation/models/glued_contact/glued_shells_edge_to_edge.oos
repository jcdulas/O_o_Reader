Node;108;;60.;10.;0.
Node;109;;70.;10.;0.
Node;110;;80.;10.;0.
Node;111;;40.;20.;0.
Node;112;;50.;20.;0.
Node;113;;60.;20.;0.
Node;114;;70.;20.;0.
Node;115;;80.;20.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;1;2;3;8;7
ShellQuad4;3;1;3;4;9;8
ShellQuad4;4;1;4;5;10;9
