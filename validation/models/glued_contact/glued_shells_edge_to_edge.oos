[executive]
# ============================================================================
# O_o_Reader validation deck: shells glued edge to edge (SOL 101)
#
# Validates:
#   - the grid points the solver glues between two coplanar plates side by side, each
#     on its own grid points along the common edge (the MPC equations of the
#     glue, punched by NLOPRM MPCPCH, and the contact status printed in the
#     listing), and the gap of each
#   - the thickness of side by side shells in the contact distance: the two
#     plates are 2 and 3 mm thick, their skins are level; the solver's automatic
#     ERROR is the thinnest shell over 4 (0.5)
# Settles (library item: current status):
#   - the shells glued edge to edge: the library takes no thickness in the gap
#     of a grid point whose shells are coplanar with the face it meets at the
#     boundary of the face (contactNodePairs(rule="solver") ties grid points
#     5, 10 and 15 of body 1 at gap 0, searched first: ISEARCH 0), not
#     validated against the solver
# Run notes:
#   - NLOPRM MPCPCH punches the glue equations (format reference BCTABLE remark 18): bring
#     the .pch back with the listing and the OUTPUT2 file
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;shells glued edge to edge
BulkEcho;Sorted
NonlinearOutputParams;PunchGlueEquations
ContactSelection;1
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;tension and bending across the glued edge
[model]
# Output files: OUTPUT2 (PARAM,POST) and, unless said otherwise, the HDF5 database
# (double precision, deflate).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
# Body 1: a 40 x 20 plate of 4 x 2 CQUAD4 at z = 0, x 0 to 40, 2 mm thick, grid
# points 1 to 15. Body 2: a 40 x 20 plate of 4 x 2 CQUAD4 at z = 0, x 40 to 80,
# 3 mm thick, grid points 101 to 115: grid points 101, 106 and 111 are at the
# place of 5, 10 and 15 (the common edge, not merged). Units: mm, N, tonne.
IsoMat;1;7.E+4;;0.33;2.7E-9
ShellProp;1;1;2.;1;;1
ShellProp;2;1;3.;1;;1
Node;1;;0.;0.;0.
Node;2;;10.;0.;0.
Node;3;;20.;0.;0.
Node;4;;30.;0.;0.
Node;5;;40.;0.;0.
Node;6;;0.;10.;0.
Node;7;;10.;10.;0.
Node;8;;20.;10.;0.
Node;9;;30.;10.;0.
Node;10;;40.;10.;0.
Node;11;;0.;20.;0.
Node;12;;10.;20.;0.
Node;13;;20.;20.;0.
Node;14;;30.;20.;0.
Node;15;;40.;20.;0.
Node;101;;40.;0.;0.
Node;102;;50.;0.;0.
Node;103;;60.;0.;0.
Node;104;;70.;0.;0.
Node;105;;80.;0.;0.
Node;106;;40.;10.;0.
