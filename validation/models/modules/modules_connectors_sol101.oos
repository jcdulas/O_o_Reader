[executive]
# ============================================================================
# O_o_Reader test model: modules joined by the connectors across modules
#
# Covers:
#   - cards: MDRBE2, MDRBE3, MDRROD, MDRJNT, MDMPC, MDBUSH, MDFAST, MDSEAM,
#     MDWELD, MDBOLT, MDBULK, MDEXCLD (with BEGIN MODULE, PFAST, PWELD,
#     PSEAM, PBUSH)
#   - solution: SOL 101 (statics of three modules)
#   - outputs: displacements, MPC forces
# Run notes:
#   - module 0 is a clamped plate; module 1 (a plate at z = 0) is found on
#     its edge x = 10; module 2 (a plate at z = 3) hangs on module 1 by the
#     connectors only, and on a stub of module 0 by a rigid joint
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: connectors across modules
BulkEcho;None
SinglePointConstrSelection;1
MultiPointConstrSelection;10
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;load on the reference point of the MDRBE3
[model]
Parameter;PostprocessingFile;-1
Parameter;AutoDependentSet;Yes
# Module 0: a plate of 1 x 2 CQUAD4 at x 0 to 10, y 0 to 20, clamped at x = 0,
# with a stub (CBAR) from point 2 up to point 60 at z = 3. Units: mm, N,
# tonne, s.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;1;1;2.;1;;1
Node;1;;0.;0.;0.
Node;2;;10.;0.;0.
Node;3;;0.;10.;0.
Node;4;;10.;10.;0.
Node;5;;0.;20.;0.
Node;6;;10.;20.;0.
ShellQuad4;1;1;1;2;4;3
ShellQuad4;2;1;3;4;6;5
SinglePointConstrList;1;123456;1;3;5
Node;60;;10.;0.;3.
BarProp;2;1;20.;40.;40.;80.
Bar2;3;2;2;60;1.;;0.;0.
# Modules 1 and 2 search their boundary automatically; point 201 of module
# 2 (on the stub end 60) is kept out of the search: a rigid joint holds it.
ModuleBulkOptions;1;;;Automatic
ModuleBulkOptions;2;;;Automatic
ModuleExcludedNodes;2;0;201
ModuleRigidJoint;301;;60;2;201;123456
# Rigid and constraint connections from module 1 (z = 0) to module 2 (z = 3).
ModuleRigidBodyStar;302;1;112;123456;2;212
ModuleRigidRod;303;1;104;2;204;;3
ModuleMultiPointConstr;10;2;208;3;1.;1;108;3;-1.
# The reference point of an interpolation element, between the plates.
Node;50;;20.;10.;1.5
ModuleRigidInterpolation;304;;50;123;6;1.;123;1;106;2;206
# A bushing, a fastener, a spot weld and a seam between the two plates.
BushProp;34;Stiffness;100.;100.;100.;100.;100.;100.
ModuleBushing;305;34;111;211;;;;;0;;;;;;1;2
FastenerProp;31;2.;;;1.E+5;1.E+5;1.E+5;;1.E+3;1.E+3;1.E+3
ModuleFastener;306;31;Property;11;12;;;;15.;5.;1.5;1;2
WeldProp;32;1;2.
ModuleWeld;307;32;;PartPatch;;;;;11;12;;1;2;;25.;;15.;;1.5
SeamProp;33;1;;2.
ModuleSeam;308;33;;ShellProp;11;12;;;;32.;;15.;1.5;38.;15.;1.5;1;2
# A rigid bolt: top points in module 1, bottom points in module 2, control
# point 70 of module 0 held fixed (no relative motion).
Node;70;;30.;5.;1.5
ModuleBolt;309;70;0;1;2;Top;2;103;107;Bottom;2;203;207
SinglePointConstrList;1;123456;70
PointForceLoad;1;50;;100.;0.;0.;1.
[model;ModuleSection;1]
# Module 1: a plate of 3 x 2 CQUAD4 at x 10 to 40, y 0 to 20, z = 0.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;11;1;2.;1;;1
Node;101;;10.;0.;0.
Node;102;;20.;0.;0.
Node;103;;30.;0.;0.
Node;104;;40.;0.;0.
Node;105;;10.;10.;0.
Node;106;;20.;10.;0.
Node;107;;30.;10.;0.
Node;108;;40.;10.;0.
Node;109;;10.;20.;0.
Node;110;;20.;20.;0.
Node;111;;30.;20.;0.
Node;112;;40.;20.;0.
ShellQuad4;101;11;101;102;106;105
ShellQuad4;102;11;102;103;107;106
ShellQuad4;103;11;103;104;108;107
ShellQuad4;104;11;105;106;110;109
ShellQuad4;105;11;106;107;111;110
ShellQuad4;106;11;107;108;112;111
[model;ModuleSection;2]
# Module 2: a plate of 3 x 2 CQUAD4 at x 10 to 40, y 0 to 20, z = 3.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;12;1;2.;1;;1
Node;201;;10.;0.;3.
Node;202;;20.;0.;3.
Node;203;;30.;0.;3.
Node;204;;40.;0.;3.
Node;205;;10.;10.;3.
Node;206;;20.;10.;3.
Node;207;;30.;10.;3.
Node;208;;40.;10.;3.
Node;209;;10.;20.;3.
Node;210;;20.;20.;3.
Node;211;;30.;20.;3.
Node;212;;40.;20.;3.
ShellQuad4;201;12;201;202;206;205
ShellQuad4;202;12;202;203;207;206
ShellQuad4;203;12;203;204;208;207
ShellQuad4;204;12;205;206;210;209
ShellQuad4;205;12;206;207;211;210
ShellQuad4;206;12;207;208;212;211
