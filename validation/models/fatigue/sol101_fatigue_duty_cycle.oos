[executive]
# ============================================================================
# O_o_Reader test model: pseudo-static stress-life fatigue with a duty cycle (SOL 101)
#
# Covers:
#   - cards: FTGDEF FTGPARM FTGLOAD FTGEVNT FTGSEQ MATFTG PFTG TABLFTG
#   - solution: SOL 101 (two unit static subcases, then the embedded fatigue
#     analysis of the FATIGUE request: rainflow counting of the superposed
#     stress histories, S-N damage)
#   - outputs: displacements, CQUAD4 stresses, the fatigue results (life,
#     damage) in the listing and the result data
# Run notes:
#   - the fatigue tables (OEFTG) have no decoder in the library yet: compare
#     them with the listing
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: stress-life fatigue, duty cycle
BulkEcho;Sorted
SinglePointConstrSelection;1
FatigueOutput;10;PrintListing;PlotOnly
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;unit case 1: tip bending, 100 N
StaticLoadSelection;1
SubcaseStart;2
LabelText;unit case 2: axial tension, 6000 N
StaticLoadSelection;2
[model]
Parameter;PostprocessingFile;-1
# A cantilever steel strip 100 x 40 mm, 3 mm thick, 5 x 2 CQUAD4, clamped
# at x = 0. Units: mm, N, t, s; stresses in MPa.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;1;1;3.;1;;1
Node;1;;0.;0.;0.
Node;2;;20.;0.;0.
Node;3;;40.;0.;0.
Node;4;;60.;0.;0.
Node;5;;80.;0.;0.
Node;6;;100.;0.;0.
Node;7;;0.;20.;0.
Node;8;;20.;20.;0.
Node;9;;40.;20.;0.
Node;10;;60.;20.;0.
Node;11;;80.;20.;0.
Node;12;;100.;20.;0.
Node;13;;0.;40.;0.
Node;14;;20.;40.;0.
Node;15;;40.;40.;0.
Node;16;;60.;40.;0.
Node;17;;80.;40.;0.
Node;18;;100.;40.;0.
ShellQuad4;1;1;1;2;8;7
ShellQuad4;2;1;2;3;9;8
ShellQuad4;3;1;3;4;10;9
ShellQuad4;4;1;4;5;11;10
ShellQuad4;5;1;5;6;12;11
ShellQuad4;6;1;7;8;14;13
ShellQuad4;7;1;8;9;15;14
ShellQuad4;8;1;9;10;16;15
ShellQuad4;9;1;10;11;17;16
ShellQuad4;10;1;11;12;18;17
SinglePointConstrList;1;123456;1;7;13
PointForceLoad;1;6;0;25.;0.;0.;1.
PointForceLoad;1;12;0;50.;0.;0.;1.
PointForceLoad;1;18;0;25.;0.;0.;1.
PointForceLoad;2;6;0;1500.;1.;0.;0.
PointForceLoad;2;12;0;3.E+3;1.;0.;0.
PointForceLoad;2;18;0;1500.;1.;0.;0.
# Fatigue material of MAT1 1: a hot rolled 0.2-0.4 % carbon steel (code
# 14), yield 355 MPa, ultimate 510 MPa, with its own one-segment S-N curve
# (stress range 2400 MPa at one cycle, slope -0.12, endurance 1.E8).
FatigueMat;1;;;Static;355.;510.;14;;;;;;StressLifeMethod;2400.;-0.12;1.E+8;0.;1.E+30
# Fatigue properties of the strip: machined surface, a notch factor 1.1.
FatigueProp;51;MachinedSurface;;1.1
# Elements of the analysis: all, less the root column (clamp singularity).
TypedListSet3;501;Elements;1;Through;10
TypedListSet3;502;Elements;1;6
FatigueDefinition;10;;;;;;;;ElemSet;1;501;51;ExcludedElemSet;1;502
# Parameters: S-N, absolute maximum principal stress, Goodman mean stress
# correction, element centre stresses, 90 % certainty of survival.
FatigueParams;10;StressLifeMethod;;;;;Stress;AbsoluteMaxPrincipal;GoodmanCorrection;;Elements;;;;;CertaintyOfSurvival;90.
# Load histories (y values only), in newtons: bending and tension, the
# same number of points (they act together in one event).
TableFatigueHistory;101;0.;100.;-60.;80.;-100.;40.;-20.;0.;EndTable
TableFatigueHistory;102;0.;6.E+3;1500.;6.E+3;1500.;6.E+3;3.E+3;0.;EndTable
# Each history scales one unit subcase: stress(t) = stress(case) * P(t) /
# LDM.
FatigueLoad;201;101;1;100.;1.;0.
FatigueLoad;202;102;2;6.E+3;1.;0.
FatigueLoad;203;101;1;100.;0.5;0.
# Events: bending with tension together; reduced bending alone.
FatigueEvent;21;2;201;202;Name;combined
FatigueEvent;22;1;203;Name;bending
# Duty cycle: 1000 combined events and 5000 bending events, reported per
# event (EVNTOUT 1), life in blocks.
FatigueSequence;10;1;0;;;2;21;1.E+3;22;5.E+3;Units;1.;blocks
