[executive]
# ============================================================================
# O_o_Reader test model: automatic beam-to-beam contact (SOL 101)
#
# Covers:
#   - cards: BCAUTOP, BCBMRAD, NLSTEP (SOL 101 LCNT form)
#   - solution: SOL 101 (linear static with contact, the contact bodies and
#     pairs generated by BCONTACT = AutoContact,TouchOnly: general touching contact,
#     the default type written out)
#   - outputs: displacements, SPC forces, bar forces, contact forces
# Run notes:
#   - two round bars (radius 2.5 mm) cross at right angles, their axes 5 mm
#     apart, so they touch; the upper one is pushed down at the crossing
#   - node-to-segment beam contact (BCPARA METHOD NODESURF, BEAMB 1) with the
#     contact radius of BCBMRAD
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: automatic beam contact (SOL 101)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
ContactSelection;AutoContact,TouchOnly
NonlinearStepSelection;13
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
SlidelineContactOutput;All;PlotOnly
SubcaseStart;1
LabelText;upper bar pushed onto the lower bar
[model]
Parameter;PostprocessingFile;-1
# Two steel round bars of 40 mm, four CBAR each, clamped at both ends: bar 1
# along x at z = 0, bar 2 along y at z = -5. Units: mm, N, t.
IsoMat;1;2.1E+5;;0.3;7.85E-9
BarShapeProp;1;1;;Rod;2.5
Node;1;;-20.;0.;0.
Node;2;;-10.;0.;0.
Node;3;;0.;0.;0.
Node;4;;10.;0.;0.
Node;5;;20.;0.;0.
Bar2;1;1;1;2;0.;;0.;1.
Bar2;2;1;2;3;0.;;0.;1.
Bar2;3;1;3;4;0.;;0.;1.
Bar2;4;1;4;5;0.;;0.;1.
Node;11;;0.;-20.;-5.
Node;12;;0.;-10.;-5.
Node;13;;0.;0.;-5.
Node;14;;0.;10.;-5.
Node;15;;0.;20.;-5.
Bar2;11;1;11;12;0.;;0.;1.
Bar2;12;1;12;13;0.;;0.;1.
Bar2;13;1;13;14;0.;;0.;1.
Bar2;14;1;14;15;0.;;0.;1.
SinglePointConstrList;1;123456;1;5;11;15
PointForceLoad;1;3;;200.;0.;0.;-1.
# Automatic contact generation: one body per connected set of elements,
# touching contact, beams included, friction 0.1
ContactAutoParams;0;ContactKind;TouchOnly;DetectionDistance;1.;BeamContact;Yes;FrictionCoefficient;0.1
ContactParams;0;ContactMethod;NodeToSurface;BeamToBeamContact;1
# Contact radius 2.5 for every beam-type element, given again for bar 2
ContactBeamRadius;2.5;All
ContactBeamRadius;2.5;ElemId;11;Through;14
# Contact iterations of SOL 101: four increments, load criterion
NonlinearStepControl;13;;LoadCasePerformance;LoadCaseContinue;4;P;;1.E-4
