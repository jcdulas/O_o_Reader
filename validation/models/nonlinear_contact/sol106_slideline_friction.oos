[executive]
# ============================================================================
# O_o_Reader test model: slideline contact with friction (SOL 106)
#
# Covers:
#   - cards: BCONP, BLSEG, BWIDTH, BFRIC, BOUTPUT
#   - solution: SOL 106 (nonlinear static, slideline contact in the x-y plane)
#   - outputs: displacements, SPC forces, the slideline contact results of
#     the secondary grid points
# Run notes:
#   - the upper block hangs from its top edge, which is pushed down and
#     sideways by enforced displacements (SPCD): no free body before contact
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;106
[case]
TitleText;O_o_Reader test model: slideline contact with friction (SOL 106)
BulkEcho;None
SinglePointConstrSelection;1
StaticLoadSelection;1
NonlinearStaticParamsSelection;10
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
SlidelineContactOutput;All;PrintListing;PlotOnly
SubcaseStart;1
LabelText;upper block pressed on the lower block and dragged
[model]
Parameter;PostprocessingFile;-1
# Two membrane blocks in the x-y plane (PSHELL with a membrane material only,
# 10 mm thick), steel. Units: mm, N, t. All grid points keep only T1 and T2.
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;1;1;10.
# Lower block 40 x 10 (4 x 1 CQUAD4), clamped on its bottom edge
Node;101;;0.;0.;0.;;3456
Node;102;;10.;0.;0.;;3456
Node;103;;20.;0.;0.;;3456
Node;104;;30.;0.;0.;;3456
Node;105;;40.;0.;0.;;3456
Node;106;;0.;10.;0.;;3456
Node;107;;10.;10.;0.;;3456
Node;108;;20.;10.;0.;;3456
Node;109;;30.;10.;0.;;3456
Node;110;;40.;10.;0.;;3456
ShellQuad4;1;1;101;102;107;106
ShellQuad4;2;1;102;103;108;107
ShellQuad4;3;1;103;104;109;108
ShellQuad4;4;1;104;105;110;109
SinglePointConstrList;1;12;101;Through;105
# Upper block 20 x 10 (2 x 1 CQUAD4) resting on the lower one with its own
# grid points; its top edge is moved by SPCD (down 0.01 mm, along x 0.002 mm)
Node;201;;10.;10.;0.;;3456
Node;202;;20.;10.;0.;;3456
Node;203;;30.;10.;0.;;3456
Node;204;;10.;20.;0.;;3456
Node;205;;20.;20.;0.;;3456
Node;206;;30.;20.;0.;;3456
ShellQuad4;11;1;201;202;205;204
ShellQuad4;12;1;202;203;206;205
SinglePointConstrList;1;12;204;205;206
EnforcedMotionConstr;1;204;1;0.002;204;2;-0.01
EnforcedMotionConstr;1;205;1;0.002;205;2;-0.01
EnforcedMotionConstr;1;206;1;0.002;206;2;-0.01
# The slideline: the secondary line is the bottom edge of the upper block,
# ordered so that its normal (z cross the segment direction) points down to
# the primary line, the top edge of the lower block (normal up). Widths are
# the 10 mm thickness of the membranes. Coulomb friction 0.2, stick stiffness
# chosen by the program.
SlidelineSegments;1;203;202;201
SlidelineSegments;2;106;Through;110
SlidelineWidth;1;10.;10.
SlidelineWidth;2;10.;10.;10.;10.
SlidelineFriction;3;;0.2
ContactSlideline;4;1;2;1.;3;1;0
# Contact results for the three secondary grid points of region 4
SlidelineOutput;4;201;Through;203
# Ten increments, stiffness updated every iteration
NonlinearStaticParams;10;10;;PseudoFullNewtonTangent;;25;PW;Yes
