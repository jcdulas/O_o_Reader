# Both arms clamped at x = 100, opened by 50 N at x = 0
SinglePointConstrList;1;123;110;210;310;410
SinglePointConstrList;1;123;510;610;710;810
PointForceLoad;1;700;;25.;0.;0.;1.
PointForceLoad;1;800;;25.;0.;0.;1.
PointForceLoad;1;100;;25.;0.;0.;-1.
PointForceLoad;1;200;;25.;0.;0.;-1.
# Glued contact: upper arm (body 2) secondary, lower arm (body 1) primary
ContactPropertyRegion;1;1
ContactPropertyRegion;2;2
ContactBody1;1;;ThreeDimensional;Deformable;1
ContactBody1;2;;ThreeDimensional;Deformable;2
ContactPairGeomParams;20;GlueOption;1;GlueSeparationOption;0
ContactPair;10;20;;2;1
ContactParams;0;NonlinearGlue;1
# The pre-crack: the interface grid points of body 2 from x = 0 to 20 use
# standard contact (selected with BCONTACT 10, same ID)
ContactUnglueNodes;10;2;500;Through;502;600;Through;602
# Crack 1: direct propagation by release of the glue, fixed increment,
# maximum hoop stress direction, resistance 0.3 N/mm, no tables
CrackClosureCrack;1;1;2;2;1;1;0.;0.3;;;0;;;;503;603
NonlinearStepControl;1;1.;;AdaptiveStepping;0.1;1.E-4;0.25
