[executive]
# ============================================================================
# O_o_Reader test model: glued double cantilever beam with a crack (SOL 400)
#
# Covers:
#   - cards: VCCT, UNGLUE
#   - solution: SOL 400 (nonlinear static, glued contact between the two
#     arms, virtual crack closure at the crack front)
#   - outputs: displacements, SPC forces, nonlinear stresses
# Run notes:
#   - two arms of 10 CHEXA (100 x 10 x 5 mm each) glued along their
#     interface (BCONPRG IGLUE 1; BCPARA NLGLUE 1 keeps it a general glue so
#     that it can be released); the first 20 mm are not glued (UNGLUE) and
#     the crack front is at x = 30 (grid points 503 and 603)
#   - the arms are opened by 50 N at x = 0; the crack may grow by releasing
#     the glue (ITYPE 2, IGROW 2) when the energy release rate exceeds 0.3
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader test model: VCCT and UNGLUE on a DCB (SOL 400)
BulkEcho;None
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
StepStart;1
LabelText;arms opened at the cracked end
AnalysisKind;NonlinearStatics
NonlinearStepSelection;1
StaticLoadSelection;1
ContactSelection;10
CrackClosureSelection;1
[model]
Parameter;PostprocessingFile;-1
# Aluminium arms, advanced nonlinear solids (PSLDN1, as VCCT needs). Lower
# arm: grid points 100 + i (y = 0, z = 0), 200 + i (y = 10, z = 0), 300 + i
# (y = 0, z = 5), 400 + i (y = 10, z = 5); upper arm: 500, 600 (z = 5), 700,
# 800 (z = 10); i = 0 to 10 along x every 10 mm; no rotations (PS 456).
# Units: mm, N, t.
IsoMat;1;7.E+4;;0.33;2.7E-9
SolidProp;1;1
SolidProp;2;1
SolidPropNonlinear;1;1;;ImplicitStructural
SolidPropNonlinear;2;1;;ImplicitStructural
