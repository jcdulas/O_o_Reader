[executive]
# ============================================================================
# O_o_Reader test model: brake squeal of a disk sector and two pads (SOL 400)
#
# Covers:
#   - cards: BSQUEAL, BRKSYS, BRKPROP, MOTION (ROTAT and TRANS)
#   - solution: SOL 400 (nonlinear static with friction contact, complex
#     modes of the frictional stiffness at half the load)
#   - outputs: displacements, SPC forces, contact forces and tractions
# Run notes:
#   - subcase 1 uses the one-wheel data of BSQUEAL 100, subcase 2 the brake
#     system BRKSYS 900 (inner pad on a rotating disk, outer pad with a
#     straight sliding direction); both continue the static analysis after
#     the complex modes (BSONLY NO)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;400
[case]
TitleText;O_o_Reader test model: brake squeal (SOL 400)
BulkEcho;None
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
SlidelineContactOutput;All;PlotOnly
SubcaseStart;1
StepStart;1
LabelText;pads pressed on the disk, squeal data of BSQUEAL 100
AnalysisKind;NonlinearStatics
NonlinearStepSelection;1
StaticLoadSelection;1
ContactSelection;1
BrakeSquealSelection;100
EigenMethodSelection;20
ComplexEigenMethodSelection;30
SubcaseStart;2
StepStart;1
LabelText;pads pressed on the disk, brake system BRKSYS 900
AnalysisKind;NonlinearStatics
NonlinearStepSelection;1
StaticLoadSelection;1
ContactSelection;1
BrakeSquealSelection;900
EigenMethodSelection;20
ComplexEigenMethodSelection;30
[model]
Parameter;PostprocessingFile;-1
# A sector of a steel disk (20 x 20 x 6 mm, 2 x 2 x 1 CHEXA, its two radial
# faces fixed) about the z axis at radius 100, squeezed by two pads (10 x 10
# x 3 mm of a soft friction material, 2 x 2 x 1 CHEXA each) under 1 MPa; the
# outer faces of the pads are held in x and y; no rotations on the grid
# points of the solids (PS 456). Units: mm, N, t.
IsoMat;1;2.1E+5;;0.3;7.85E-9
IsoMat;2;5.E+3;;0.25;2.5E-9
SolidProp;1;1
SolidProp;2;2
SolidProp;3;2
# The disk sector: grid points 1 to 18, elements 1 to 4
Node;1;;90.;-10.;0.;;456
Node;2;;100.;-10.;0.;;456
Node;3;;110.;-10.;0.;;456
Node;4;;90.;0.;0.;;456
Node;5;;100.;0.;0.;;456
Node;6;;110.;0.;0.;;456
Node;7;;90.;10.;0.;;456
Node;8;;100.;10.;0.;;456
Node;9;;110.;10.;0.;;456
Node;10;;90.;-10.;6.;;456
Node;11;;100.;-10.;6.;;456
Node;12;;110.;-10.;6.;;456
Node;13;;90.;0.;6.;;456
Node;14;;100.;0.;6.;;456
Node;15;;110.;0.;6.;;456
Node;16;;90.;10.;6.;;456
Node;17;;100.;10.;6.;;456
Node;18;;110.;10.;6.;;456
SolidHexa;1;1;1;2;5;4;10;11;14;13
SolidHexa;2;1;2;3;6;5;11;12;15;14
SolidHexa;3;1;4;5;8;7;13;14;17;16
SolidHexa;4;1;5;6;9;8;14;15;18;17
SinglePointConstrList;1;123;1;4;7;10;13;16
SinglePointConstrList;1;123;3;6;9;12;15;18
# The inner pad on top: grid points 101 to 118, elements 11 to 14
Node;101;;95.;-5.;6.;;456
Node;102;;100.;-5.;6.;;456
Node;103;;105.;-5.;6.;;456
Node;104;;95.;0.;6.;;456
Node;105;;100.;0.;6.;;456
Node;106;;105.;0.;6.;;456
Node;107;;95.;5.;6.;;456
Node;108;;100.;5.;6.;;456
Node;109;;105.;5.;6.;;456
Node;110;;95.;-5.;9.;;456
Node;111;;100.;-5.;9.;;456
Node;112;;105.;-5.;9.;;456
Node;113;;95.;0.;9.;;456
Node;114;;100.;0.;9.;;456
Node;115;;105.;0.;9.;;456
Node;116;;95.;5.;9.;;456
Node;117;;100.;5.;9.;;456
Node;118;;105.;5.;9.;;456
SolidHexa;11;2;101;102;105;104;110;111;114;113
SolidHexa;12;2;102;103;106;105;111;112;115;114
SolidHexa;13;2;104;105;108;107;113;114;117;116
SolidHexa;14;2;105;106;109;108;114;115;118;117
SinglePointConstrList;1;12;110;Through;118
FacePressureLoad;1;11;1.;;;;110;114
FacePressureLoad;1;12;1.;;;;111;115
FacePressureLoad;1;13;1.;;;;113;117
FacePressureLoad;1;14;1.;;;;114;118
# The outer pad below: grid points 201 to 218, elements 21 to 24
Node;201;;95.;-5.;-3.;;456
Node;202;;100.;-5.;-3.;;456
Node;203;;105.;-5.;-3.;;456
Node;204;;95.;0.;-3.;;456
Node;205;;100.;0.;-3.;;456
Node;206;;105.;0.;-3.;;456
Node;207;;95.;5.;-3.;;456
Node;208;;100.;5.;-3.;;456
Node;209;;105.;5.;-3.;;456
Node;210;;95.;-5.;0.;;456
Node;211;;100.;-5.;0.;;456
Node;212;;105.;-5.;0.;;456
Node;213;;95.;0.;0.;;456
Node;214;;100.;0.;0.;;456
Node;215;;105.;0.;0.;;456
Node;216;;95.;5.;0.;;456
Node;217;;100.;5.;0.;;456
Node;218;;105.;5.;0.;;456
SolidHexa;21;3;201;202;205;204;210;211;214;213
SolidHexa;22;3;202;203;206;205;211;212;215;214
SolidHexa;23;3;204;205;208;207;213;214;217;216
SolidHexa;24;3;205;206;209;208;214;215;218;217
SinglePointConstrList;1;12;201;Through;209
FacePressureLoad;1;21;1.;;;;201;205
FacePressureLoad;1;22;1.;;;;202;206
FacePressureLoad;1;23;1.;;;;204;208
FacePressureLoad;1;24;1.;;;;205;209
# Contact: the pads (secondary) on the disk (primary), friction 0.3
ContactPropertyRegion;1;1
ContactPropertyRegion;2;2
ContactPropertyRegion;3;3
ContactBody1;1;;ThreeDimensional;Deformable;1
ContactBody1;2;;ThreeDimensional;Deformable;2
ContactBody1;3;;ThreeDimensional;Deformable;3
ContactPairPhysicalParams;30;FrictionCoefficient;0.3
ContactPair;10;;30;2;1
ContactPair;11;;30;3;1
ContactTable1;1;10;11
# One wheel: rotation about the z axis through the origin, contact
# stiffness 1.E5 per unit area, squeal at load factor 0.5
BrakeSqueal;100;0.5;1.E+5;No;0.;0.;1.;0.;0.;0.
# Brake system: the inner pair moves with the disk rotation (MOTION 41,
# used for both bodies), the outer pair along +y, the local direction of
# that rotation at the pads (MOTION 42); the inner pair has its own
# friction, the outer pair takes the friction of the contact table
BrakeSystem;900;0.5;0;No;0;INNER;1;2;41;;51;OUTER;1;3;42;42;52
BrakeProp;51;AverageStiffnessMethod;1.E+5;Friction;0.3
BrakeProp;52;AverageStiffnessMethod;1.E+5;Friction;0.
BrakeMotion;41;10.;RotationMotion;0.;0.;1.;0.;0.;0.
BrakeMotion;42;1.E+3;TranslationMotion;0.;1.;0.
# Ten load increments; real and complex eigenvalue methods
NonlinearStepControl;1;1.;;FixedStepping;10
LanczosEigenMethod;20;;;10
ComplexEigenMethod;30;HessenbergMethod;Maximum;;;;10
