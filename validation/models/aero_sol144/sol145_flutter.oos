[executive]
# ============================================================================
# O_o_Reader validation deck: flutter (SOL 145, PK method)
#
# Validates:
#   - the flutter summary (OVG) and the flutter eigenvectors in the OUTPUT2 file and in
#     the HDF5 file of one run
# Settles (library item: current status):
#   - flutter_summary (experimental: checked against a listing only)
#   - the flutter datasets of the HDF5 file (never observed: raw tables)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;145
[case]
TitleText;O_o_Reader validation: flutter
BulkEcho;Sorted
SinglePointConstrSelection;1
EigenMethodSelection;71
FlutterMethodSelection;81
ModalDampingSelection;72
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;PK flutter at Mach 0.5
[model]
# Output files: OUTPUT2 (PARAM,POST,-1) and the HDF5 database (double precision,
# deflate filter).
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;ReferenceVelocity;1.
Parameter;LowestModesCount;6
AeroUnsteadyParams;;1.E+5;200.;1.2E-12
LanczosEigenMethod;71;;;6
TableModalDamping1;72;CriticalDamping;0.;0.02;1.E+3;0.02;EndTable
AeroMachFreqTable1;0.5;;;;;;;;0.001;0.05;0.1;0.3;0.6;1.
AeroFlutter;81;PkMethod;1;2;3;Linear;6
AeroFlutterFactors;1;1.
AeroFlutterFactors;2;0.5
AeroFlutterFactors;3;5.E+4;1.E+5;1.5E+5;2.E+5;2.5E+5;3.E+5
Include;aero_model.oos
