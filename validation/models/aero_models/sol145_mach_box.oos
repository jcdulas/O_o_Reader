[executive]
# ============================================================================
# O_o_Reader test model: supersonic Mach box flutter (SOL 145)
#
# Covers:
#   - cards: CAERO3 PAERO3 MKAERO2 SPLINE4
#   - solution: SOL 145 (PK flutter of the plate wing at Mach 1.3, Mach box
#     lifting surface)
#   - outputs: flutter summary, real eigenvalues and eigenvectors of the
#     structural modes
# Run notes:
#   - the Mach box method needs a supersonic Mach number; the surface has no
#     crank and no control surface
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;145
[case]
TitleText;O_o_Reader test model: Mach box flutter
BulkEcho;None
SinglePointConstrSelection;1
EigenMethodSelection;71
FlutterMethodSelection;81
ModalDampingSelection;72
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;PK flutter at Mach 1.3
[model]
Parameter;PostprocessingFile;-1
Parameter;LowestModesCount;6
AeroUnsteadyParams;;4.5E+5;200.;1.2E-12;1
LanczosEigenMethod;71;;;6
TableModalDamping1;72;CriticalDamping;0.;0.02;1.E+3;0.02;EndTable
Include;plate_wing.oos
# Mach box surface over the plate (no crank: Y5 and Y6 negative). The 12
# (x, y) pairs of AEFACT 2002, in the element system, are the interpolation
# points; they are numbered 2000 to 2011 from the CAERO3 ID.
AeroMachBoxProp3;2001;10;0;0.;-1.;0.;-1.
AeroMachBoxPanel3;2000;2001;0;2002;;;0.;0.;0.;200.;0.;1.E+3;0.;200.
AeroFactorList;2002;20.;100.;100.;100.;180.;100.;20.;400.;100.;400.;180.;400.;20.;700.;100.;700.;180.;700.;20.;950.;100.;950.;180.;950.
# Infinite plate spline from the Mach box points to every plate grid point.
IdListSet1;2102;1;Through;15
AeroBoxList;2101;2000;Through;2011
AeroSurfaceSpline4;2100;2000;2101;2102;0.;InfinitePlateSpline
# One Mach number, six reduced frequencies (pairs of m and k).
AeroMachFreqPairs2;1.3;0.001;1.3;0.01;1.3;0.05;1.3;0.1
AeroMachFreqPairs2;1.3;0.2;1.3;0.5
# PK method: density ratio 1, Mach 1.3, velocities in mm/s.
AeroFlutter;81;PkMethod;1;2;3;Linear;6
AeroFlutterFactors;1;1.
AeroFlutterFactors;2;1.3
AeroFlutterFactors;3;3.E+5;4.5E+5;6.E+5;7.5E+5;9.E+5
