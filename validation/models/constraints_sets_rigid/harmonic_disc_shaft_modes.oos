[executive]
# ============================================================================
# O_o_Reader test model: axisymmetric harmonic disc tied to a beam shaft by
# RBAX3D (SOL 103)
#
# Covers:
#   - cards: RBAX3D
#   - solution: SOL 103 (normal modes of a shaft carrying a disc)
#   - outputs: eigenvalues, eigenvectors
# Run notes:
#   - the disc is two CQUADX with PAXSYMH harmonic index 1 (axis of
#     symmetry: basic y); each RBAX3D ties an inner disc point to the shaft
#     grid point at the same y
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader test model: harmonic disc on a shaft (RBAX3D)
BulkEcho;None
SinglePointConstrSelection;1
EigenMethodSelection;1
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;modes of the shaft and disc
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s. Steel.
IsoMat;1;2.1E+5;;0.3;7.85E-9
# Shaft: 10 CBAR along y (x = z = 0) from y = -50 to 50, radius 5 mm,
# clamped at y = -50 and held in translation at y = 50.
BarProp;1;1;78.54;490.9;490.9;981.7
Node;1;;0.;-50.;0.
Node;2;;0.;-40.;0.
Node;3;;0.;-30.;0.
Node;4;;0.;-20.;0.
Node;5;;0.;-10.;0.
Node;6;;0.;0.;0.
Node;7;;0.;10.;0.
Node;8;;0.;20.;0.
Node;9;;0.;30.;0.
Node;10;;0.;40.;0.
Node;11;;0.;50.;0.
Bar2;1;1;1;2;0.;;0.;1.
Bar2;2;1;2;3;0.;;0.;1.
Bar2;3;1;3;4;0.;;0.;1.
Bar2;4;1;4;5;0.;;0.;1.
Bar2;5;1;5;6;0.;;0.;1.
Bar2;6;1;6;7;0.;;0.;1.
Bar2;7;1;7;8;0.;;0.;1.
Bar2;8;1;8;9;0.;;0.;1.
Bar2;9;1;9;10;0.;;0.;1.
Bar2;10;1;10;11;0.;;0.;1.
SinglePointConstrList;1;123456;1
SinglePointConstrList;1;123;11
# Disc: radius 10 to 50 (basic x), y 0 to 10, two CQUADX harmonic
# elements (harmonic index 1).
AxisymHarmonicProp;2;1
Node;101;;10.;0.;0.
Node;102;;30.;0.;0.
Node;103;;50.;0.;0.
Node;111;;10.;10.;0.
Node;112;;30.;10.;0.
Node;113;;50.;10.;0.
AxisymQuad;201;2;101;102;112;111
AxisymQuad;202;2;102;103;113;112
# Rigid ties of the inner disc points to the shaft (same axial position).
RigidAxisymConnection;301;6;101
RigidAxisymConnection;302;7;111
LanczosEigenMethod;1;;;6
