[executive]
# ============================================================================
# O_o_Reader test model: pseudo-static fatigue on elements chosen by
# property set and excluded by element set (SOL 101)
#
# Covers:
#   - cards: SET4 (PROP PSHELL), SET3 (ELEM, as an excluded set)
#   - solution: SOL 101 (linear statics with a stress-life fatigue analysis
#     of a constant amplitude, fully reversed load)
#   - outputs: displacements, element stresses (fatigue results to the listing)
# Run notes:
#   - FATIGUE = 1 selects FTGDEF, FTGPARM and FTGLOAD 1; the run needs the
#     embedded fatigue license
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: fatigue element sets by property
BulkEcho;None
FatigueOutput;1
SinglePointConstrSelection;1
DisplacementOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;unit tip load, the fatigue load case
StaticLoadSelection;1
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s. Steel plate 40 x 20, 4 x 2 CQUAD4, clamped at
# x = 0; the root bay is 3 mm thick (PSHELL 1), the rest 2 mm (PSHELL 2).
IsoMat;1;2.1E+5;;0.3;7.85E-9
ShellProp;1;1;3.;1;;1
ShellProp;2;1;2.;1;;1
Node;1;;0.;0.;0.
Node;2;;10.;0.;0.
Node;3;;20.;0.;0.
Node;4;;30.;0.;0.
Node;5;;40.;0.;0.
Node;6;;0.;10.;0.
Node;7;;10.;10.;0.
Node;8;;20.;10.;0.
Node;9;;30.;10.;0.
Node;10;;40.;10.;0.
Node;11;;0.;20.;0.
Node;12;;10.;20.;0.
Node;13;;20.;20.;0.
Node;14;;30.;20.;0.
Node;15;;40.;20.;0.
ShellQuad4;1;1;1;2;7;6
ShellQuad4;2;2;2;3;8;7
ShellQuad4;3;2;3;4;9;8
ShellQuad4;4;2;4;5;10;9
ShellQuad4;5;1;6;7;12;11
ShellQuad4;6;2;7;8;13;12
ShellQuad4;7;2;8;9;14;13
ShellQuad4;8;2;9;10;15;14
SinglePointConstrList;1;123456;1;6;11
PointForceLoad;1;5;0;20.;0.;0.;1.
PointForceLoad;1;10;0;20.;0.;0.;1.
PointForceLoad;1;15;0;20.;0.;0.;1.
# Fatigue: the elements of both PSHELL (SET4 71) less the tip elements
# (SET3 72), stress-life curve of the steel, the subcase 1 stresses cycled
# between +1 and -1 times.
PropertyListSet4;71;Property;ShellProp;1;2
TypedListSet3;72;Elements;4;8
FatigueDefinition;1;;;;;;;;ElemSet;1;71;;ExcludedElemSet;1;72
FatigueParams;1;StressLifeMethod
FatigueMat;1;;;Static;430.;682.;;;;;;;StressLifeMethod;3095.;-0.1339;1.E+8
FatigueLoad;1;;1;;1.;-1.;ConstantLoad
