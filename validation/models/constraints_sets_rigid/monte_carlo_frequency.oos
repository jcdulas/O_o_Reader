[executive]
# ============================================================================
# O_o_Reader test model: Monte-Carlo simulation of a modal frequency
# response (SOL 111)
#
# Covers:
#   - cards: MONCARL
#   - solution: SOL 111 (modal frequency response, with random structural
#     mass and stiffness variability by the non-parametric method)
#   - outputs: complex displacements of the beam tip (one subcase for each
#     random sample)
# Run notes:
#   - MONCARL(NSAMPLE=4,SEED=7) = 1 asks for four random samples; each one
#     is written as its own subcase
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;111
[case]
TitleText;O_o_Reader test model: Monte-Carlo modal frequency response
BulkEcho;None
MonteCarloSelection;1;NSAMPLE=4;SEED=7
SinglePointConstrSelection;1
EigenMethodSelection;1
ModalDampingSelection;40
DynamicLoadSelection;100
FreqSetSelection;30
SetDefinition;1;11
DisplacementOutput;1;PlotOnly
SubcaseStart;1
LabelText;unit tip load
[model]
Parameter;PostprocessingFile;-1
# Units: mm, N, tonne, s. Aluminium cantilever 200 mm long, 10 x 5 mm
# section, 10 CBAR, clamped at grid point 1.
IsoMat;1;7.E+4;;0.33;2.7E-9
BarProp;1;1;50.;104.2;416.7;286.
Node;1;;0.;0.;0.
Node;2;;20.;0.;0.
Node;3;;40.;0.;0.
Node;4;;60.;0.;0.
Node;5;;80.;0.;0.
Node;6;;100.;0.;0.
Node;7;;120.;0.;0.
Node;8;;140.;0.;0.
Node;9;;160.;0.;0.
Node;10;;180.;0.;0.
Node;11;;200.;0.;0.
Bar2;1;1;1;2;0.;;0.;1.
Bar2;2;1;2;3;0.;;0.;1.
Bar2;3;1;3;4;0.;;0.;1.
Bar2;4;1;4;5;0.;;0.;1.
Bar2;5;1;5;6;0.;;0.;1.
Bar2;6;1;6;7;0.;;0.;1.
Bar2;7;1;7;8;0.;;0.;1.
Bar2;8;1;8;9;0.;;0.;1.
Bar2;9;1;9;10;0.;;0.;1.
Bar2;10;1;10;11;0.;;0.;1.
SinglePointConstrList;1;123456;1
# Six modes, 2 percent critical damping, unit tip load in z, 10 to 200 Hz.
LanczosEigenMethod;1;;;6
TableModalDamping1;40;CriticalDamping;0.;0.02;1.E+3;0.02;EndTable
DynamicLoadScale;10;11;3;1.
FreqResponseLoad1;100;10;;;;;20
TableDynamic1;20;;;0.;1.;1.E+3;1.;EndTable
FreqLinearSteps1;30;10.;10.;19
# Alpha variabilities: structural mass and stiffness 0.01, damping none.
MonteCarloParams;1;;StructuralVariation;0.01;0.01;0.
