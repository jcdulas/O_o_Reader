[executive]
# ============================================================================
# O_o_Reader test model: extra points as actuator states coupled to a beam
# by transfer functions (SOL 108)
#
# Covers:
#   - cards: EPOINT
#   - solution: SOL 108 (direct frequency response)
#   - outputs: complex displacements (grid points and extra points)
# Run notes:
#   - each extra point is a first-order lag (time constant 1 ms) driven by a
#     unit DAREA; a TF row adds 100 times its value as a force on the beam
#     tip (z for 5001, y for 5002)
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;108
[case]
TitleText;O_o_Reader test model: extra points and transfer functions
BulkEcho;None
SinglePointConstrSelection;1
TransferFunctionSelection;1
DynamicLoadSelection;100
FreqSetSelection;30
DisplacementOutput;All;PlotOnly
SubcaseStart;1
LabelText;actuators driven by unit loads
[model]
Parameter;PostprocessingFile;-1
Parameter;UniformStructuralDamping;0.02
# Units: mm, N, tonne, s. Aluminium cantilever 200 mm long, 10 x 5 mm
# section, 10 CBAR, clamped at grid point 1.
IsoMat;1;7.E+4;;0.33;2.7E-9
BarProp;1;1;50.;104.2;416.7;286.
Node;1;;0.;0.;0.
Node;2;;20.;0.;0.
Node;3;;40.;0.;0.
Node;4;;60.;0.;0.
Node;5;;80.;0.;0.
Node;6;;100.;0.;0.
Node;7;;120.;0.;0.
Node;8;;140.;0.;0.
Node;9;;160.;0.;0.
Node;10;;180.;0.;0.
Node;11;;200.;0.;0.
Bar2;1;1;1;2;0.;;0.;1.
Bar2;2;1;2;3;0.;;0.;1.
Bar2;3;1;3;4;0.;;0.;1.
Bar2;4;1;4;5;0.;;0.;1.
Bar2;5;1;5;6;0.;;0.;1.
Bar2;6;1;6;7;0.;;0.;1.
Bar2;7;1;7;8;0.;;0.;1.
Bar2;8;1;8;9;0.;;0.;1.
Bar2;9;1;9;10;0.;;0.;1.
Bar2;10;1;10;11;0.;;0.;1.
SinglePointConstrList;1;123456;1
# Two extra points (actuator states).
ExtraPoint;5001;Through;5002
# Rows of the extra points: (1 + 0.001 p) e = load.
TransferFunction;1;5001;0;1.;0.001
TransferFunction;1;5002;0;1.;0.001
# Rows of the tip: the actuator forces.
TransferFunction;1;11;3;0.;;;5001;0;-100.
TransferFunction;1;11;2;0.;;;5002;0;-100.
# Unit loads on the extra points, 10 to 200 Hz.
DynamicLoadScale;10;5001;0;1.;5002;0;1.
FreqResponseLoad1;100;10;;;;;20
TableDynamic1;20;;;0.;1.;1.E+3;1.;EndTable
FreqLinearSteps1;30;10.;10.;19
