[executive]
# ============================================================================
# O_o_Reader test model: transient run-up with an unbalance (SOL 109)
#
# Covers:
#   - cards: RSPINT, UNBALNC (transient form, with output extra points)
#   - solution: SOL 109 (direct transient response with gyroscopic effects)
#   - outputs: displacements (with the extra points): real, SORT2
# Run notes:
#   - RGYRO = 400 selects the unbalance UNBALNC 400 (in transient response
#     RGYRO names the UNBALNC set); RSPINT gives the spin rate histories:
#     rotor 10 runs up to 3000 rpm in 0.2 s (TABLED1 401), rotor 20 to 6000
#     rpm (TABLED1 402)
#   - extra points: 4001 carries the speed of rotor 10, 4011 and 4012 the
#     unbalance forces along y and z
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;109
[case]
TitleText;O_o_Reader test model: transient run-up
BulkEcho;None
SinglePointConstrSelection;1
RotordynamicSelection;400
TimeStepSelection;60
DisplacementOutput;All;PlotOnly;SortByTime
SubcaseStart;1
LabelText;run-up with the disk unbalance
[model]
Parameter;PostprocessingFile;-1
Parameter;UniformStructuralDamping;0.02
Parameter;DampingReferenceFreq;300.
TransientTimeSteps;60;400;5.E-4;2
# Spin rate histories.
RotorTransientSpin;10;1001;1005;RevolutionsPerMinute;401;4001
RotorTransientSpin;20;2001;2003;RevolutionsPerMinute;402
TableDynamic1;401;;;0.;0.;0.2;3.E+3;1.;3.E+3;EndTable
TableDynamic1;402;;;0.;0.;0.2;6.E+3;1.;6.E+3;EndTable
# Unbalance: 10 g at 10 mm on grid point 1003, on from 0 to 0.2 s, no mass or
# speed correction; its forces along T2 and T3 on extra points 4011 and 4012.
RotorUnbalanceLoad;400;;1.E-5;1003;0.;1.;0.;;10.;0.;;0.;0.;0.2;None;;4011;4012
ExtraPoint;4001;4011;4012
Include;rotor_line_model.oos
