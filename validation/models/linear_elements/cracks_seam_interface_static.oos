[executive]
# ============================================================================
# O_o_Reader test model: crack tips, seam weld, line interface
#
# Covers:
#   - cards: CRAC2D, PRAC2D, CRAC3D, PRAC3D, CSEAM, PSEAM, CINTC, GMBNDC (with
#     ADUM8, ADUM9, CQUAD4, PSHELL)
#   - solution: SOL 101 (linear static, one subcase)
#   - outputs: displacements, SPC forces, MPC forces, element stresses and
#     forces (OUTPUT2); the stress intensity factors of the crack tip elements
#     (listing)
# Run notes:
#   - CRAC2D and CRAC3D are dummy elements: the ADUM8 and ADUM9 entries the
#     format reference asks for are in the deck
#   - the CINTC interface writes MPC equations (MPC forces); GMBNDC remark:
#     PARAM,BAILOUT,-1 lets the run go on past the high factor diagonal ratios
#     an interface element may give
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;101
[case]
TitleText;O_o_Reader test model: crack tips, seam weld, line interface
BulkEcho;Sorted
SinglePointConstrSelection;1
StaticLoadSelection;1
DisplacementOutput;All;PlotOnly
SinglePointConstrForceOutput;All;PlotOnly
MultiPointConstrForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;crack opening, seam and interface loads
[model]
Parameter;PostprocessingFile;-1
Parameter;SingularityBailOut;-1
# Units: mm, N, tonne, s. Steel (MAT1 1).
IsoMat;1;2.1E+5;;0.3;7.85E-9
