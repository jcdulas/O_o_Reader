[executive]
# ============================================================================
# O_o_Reader validation deck: fluid element results, real (coupled modes) (SOL 103)
#
# Validates:
#   - the element tables of the fluid elements CHEXA, CPENTA, CTETRA and
#     CPYRAM on PFLUID (element types 76 to 79: two words of text,
#     accelerations, velocities, pressure), the pressures at the fluid grid
#     points, the grid point weight with fluid elements
# Run notes:
#   - the element output of a fluid element is asked with FORCE (and STRESS);
#     keep whatever the solver writes
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;103
[case]
TitleText;O_o_Reader validation: fluid elements (real (coupled modes))
BulkEcho;Sorted
SinglePointConstrSelection;1
EigenMethodSelection;71
DisplacementOutput;All;PlotOnly
ElemForceOutput;All;PlotOnly
StressOutput;All;PlotOnly
SubcaseStart;1
LabelText;plate-driven cavity
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;WeightReferenceNode;0
LanczosEigenMethod;71;;;8
Include;acoustic_model.oos
