[executive]
# ============================================================================
# O_o_Reader validation deck: modal transient response (SOL 112), SORT1
#
# Validates:
#   - the real SORT1 tables of a transient response: displacements,
#     velocities, accelerations, SPC and MPC forces, applied loads, stresses,
#     strains and forces of every family of the shared model
#   - the HDF5 NODAL/VELOCITY, NODAL/ACCELERATION, NODAL/MPC_FORCE of the same
#     run
# Settles (library item: current status):
#   - NODAL/ACCELERATION (no decoder: never observed) and NODAL/VELOCITY,
#     NODAL/MPC_FORCE (not_validated); the HDF5 writer's 'no-observed-layout'
#     for accelerations
#   - the OUTPUT2 file and HDF5 files of one transient run that is not a mechanism
# Run notes:
#   - the transient load is load set 1 times a ramp (TABLED1 52); 100 steps of
#     1e-4 s, output every 5th
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;112
[case]
TitleText;O_o_Reader validation: transient response (SORT1)
BulkEcho;Sorted
SinglePointConstrSelection;1
MultiPointConstrSelection;50
EigenMethodSelection;71
ModalDampingSelection;72
DynamicLoadSelection;51
TimeStepSelection;61
DisplacementOutput;All;PlotOnly;SortByPoint
VelocityOutput;All;PlotOnly;SortByPoint
AccelOutput;All;PlotOnly;SortByPoint
SinglePointConstrForceOutput;All;PlotOnly;SortByPoint
MultiPointConstrForceOutput;All;PlotOnly;SortByPoint
AppliedLoadOutput;All;PlotOnly;SortByPoint
StressOutput;All;PlotOnly;SortByPoint;CornerResults
StrainOutput;All;PlotOnly;SortByPoint;FiberDistance;CornerResults
ElemForceOutput;All;PlotOnly;SortByPoint;CornerResults
SubcaseStart;1
LabelText;ramped load set 1
[model]
# Output files: the OUTPUT2 file (PARAM,POST,-1, with the geometry) and the HDF5
# database in double precision with the deflate (GZIP) filter.
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
LanczosEigenMethod;71;;;12
TableModalDamping1;72;CriticalDamping;0.;0.02;2.E+3;0.02;EndTable
TransientTableLoad1;51;1;;;;52
TableDynamic1;52;;;0.;0.;0.002;1.;1.;1.;EndTable
TransientTimeSteps;61;100;1.E-4;5
Include;../common/elements_model.oos
