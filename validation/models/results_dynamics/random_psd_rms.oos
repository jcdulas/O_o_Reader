[executive]
# ============================================================================
# O_o_Reader validation deck: random response (SOL 111 with RANDPS)
#
# Validates:
#   - the PSD, autocorrelation, cumulative RMS, RMS and number of zero
#     crossings tables (OUG/OES/OSTR/OEF/OQMG with PSD, ATO, CRM, RMS, NO) of
#     nodal results, MPC forces and the element families of the shared model
#   - the random strain energy (5-word entry)
#   - the HDF5 domains with RANDOM not zero (no decoder today: their layout)
# Settles (library item: current status):
#   - the not_validated 'random' lines in SORT1 and SORT2
#     (forces of 30 element types, stresses and strains of 20, mpc_forces
#     random SORT1)
#   - the RMS strain energy, the RMS and NO tables, the PSD stress of CQUADR
#   - a random analysis stays raw in the HDF5 reader (never observed)
# Run notes:
#   - the listing (RPRINT) gives the printed PSD and RMS values the comparison
#     needs
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;111
[case]
TitleText;O_o_Reader validation: random response
BulkEcho;Sorted
SinglePointConstrSelection;1
MultiPointConstrSelection;50
EigenMethodSelection;71
ModalDampingSelection;72
DynamicLoadSelection;21
FreqSetSelection;41
RandomAnalysisSelection;91
DisplacementOutput;All;PlotOnly;SpectralDensityFunction;AutocorrelationFunction;CumulativeRootMeanSquare;AllRandomResults;RandomPrint
AccelOutput;All;PlotOnly;SpectralDensityFunction;CumulativeRootMeanSquare;RandomPrint
MultiPointConstrForceOutput;All;PlotOnly;SpectralDensityFunction;CumulativeRootMeanSquare;RandomPrint
SinglePointConstrForceOutput;All;PlotOnly;SpectralDensityFunction;CumulativeRootMeanSquare;RandomPrint
StressOutput;All;PlotOnly;SpectralDensityFunction;AutocorrelationFunction;CumulativeRootMeanSquare;AllRandomResults;RandomPrint
StrainOutput;All;PlotOnly;SpectralDensityFunction;CumulativeRootMeanSquare;RandomPrint
ElemForceOutput;All;PlotOnly;SpectralDensityFunction;AutocorrelationFunction;CumulativeRootMeanSquare;AllRandomResults;RandomPrint
ElemStrainEnergyOutput;All;PlotOnly
SubcaseStart;1
LabelText;base load set 1, white noise
[model]
# Output files: the OUTPUT2 file (PARAM,POST,-1, with the geometry) and the HDF5
# database in double precision with the deflate (GZIP) filter.
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
LanczosEigenMethod;71;;;12
FreqLinearSteps1;41;5.;5.;40
TableDynamic1;31;;;0.;1.;2.E+3;1.;EndTable
FreqResponseLoad1;21;1;;;;;31
TableModalDamping1;72;CriticalDamping;0.;0.02;2.E+3;0.02;EndTable
RandomSpectralDensity;91;1;1;1.;0.;92
TableRandomSpectrum1;92;;;1.;1.;2.E+3;1.;EndTable
Include;../common/elements_model.oos
