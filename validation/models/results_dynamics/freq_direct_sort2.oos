[executive]
# ============================================================================
# O_o_Reader validation deck: direct frequency response (SOL 108), SORT2
#
# Validates:
#   - the complex SORT2 tables, real/imaginary (subcase 1) and magnitude/phase
#     (subcase 2), of every family of the shared model: nodal (displacement,
#     velocity, acceleration, SPC, MPC, applied loads) and element (stress,
#     strain, force of springs, dampers, rods, bars, beams, bends, shells,
#     laminates, solids, bushes, fasteners, welds)
#   - complex grid point forces (the complex cuts of section_cut)
#   - the HDF5 *_CPLX datasets of the same run (matching result data)
# Run notes:
#   - direct frequency response: structural damping from MAT1 GE and PARAM,G;
#     dampers, CVISC and CBUSH B
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;108
[case]
TitleText;O_o_Reader validation: direct frequency response (SORT2)
BulkEcho;Sorted
SinglePointConstrSelection;1
MultiPointConstrSelection;50
DynamicLoadSelection;21
FreqSetSelection;41
NodeForceOutput;All;PlotOnly
SubcaseStart;1
LabelText;real and imaginary parts
DisplacementOutput;All;PlotOnly;SortByTime;RealPart
VelocityOutput;All;PlotOnly;SortByTime;RealPart
AccelOutput;All;PlotOnly;SortByTime;RealPart
SinglePointConstrForceOutput;All;PlotOnly;SortByTime;RealPart
MultiPointConstrForceOutput;All;PlotOnly;SortByTime;RealPart
AppliedLoadOutput;All;PlotOnly;SortByTime;RealPart
StressOutput;All;PlotOnly;SortByTime;RealPart;CornerResults
StrainOutput;All;PlotOnly;SortByTime;RealPart;FiberDistance;CornerResults
ElemForceOutput;All;PlotOnly;SortByTime;RealPart;CornerResults
SubcaseStart;2
LabelText;magnitude and phase
DisplacementOutput;All;PlotOnly;SortByTime;MagnitudePhase
VelocityOutput;All;PlotOnly;SortByTime;MagnitudePhase
AccelOutput;All;PlotOnly;SortByTime;MagnitudePhase
SinglePointConstrForceOutput;All;PlotOnly;SortByTime;MagnitudePhase
MultiPointConstrForceOutput;All;PlotOnly;SortByTime;MagnitudePhase
AppliedLoadOutput;All;PlotOnly;SortByTime;MagnitudePhase
StressOutput;All;PlotOnly;SortByTime;MagnitudePhase;CornerResults
StrainOutput;All;PlotOnly;SortByTime;MagnitudePhase;FiberDistance;CornerResults
ElemForceOutput;All;PlotOnly;SortByTime;MagnitudePhase;CornerResults
[model]
Parameter;PostprocessingFile;-1
ResultFileParams;Precision;64;CompressionMethod;GzipCompression
Parameter;UniformStructuralDamping;0.02
FreqLinearSteps1;41;5.;5.;40
TableDynamic1;31;;;0.;1.;2.E+3;1.;EndTable
FreqResponseLoad1;21;1;;;;;31
Include;../common/elements_model.oos
