[executive]
# ============================================================================
# O_o_Reader test model: thermostat-controlled heater, transient
#
# Covers:
#   - cards: CONTRLT, TEMPBC (TYPE = TRAN), QBDY3 with a control point
#   - solution: SOL 159 (transient nonlinear heat transfer)
#   - outputs: temperatures, element heat flux and boundary heat flows,
#     SORT1
# Run notes:
#   - an aluminium plate heated by a flux switched by a bang-bang
#     thermostat (on below 40 C, off above 45 C, sensor at its centre)
#     and cooled by free convection to an ambient point whose temperature
#     rises from 20 C to 30 C (TEMPBC TRAN)
#   - 150 steps of 10 s, every tenth step written
#   - units: mm, t, s, N, mJ, mW, degrees C
# Written for this project, to exercise the reader.
# How to run it, what to bring back: validation/models/README.md.
# ============================================================================
SolutionSequence;159
[case]
TitleText;O_o_Reader test model: thermostat (SOL 159)
BulkEcho;None
DynamicLoadSelection;50
NonlinearTimeStepSelection;1
TemperatureSelection;2;InitialTemperature
ThermalOutput;All;PlotOnly;SortByPoint
HeatFluxOutput;All;PlotOnly;SortByPoint
SubcaseStart;1
LabelText;heater cycling under a thermostat
[model]
Parameter;PostprocessingFile;-1
NonlinearTimeSteps;1;150;10.;10
DefaultTemperatureLoad;2;20.
# Aluminium plate 100 x 100 mm, 2 mm thick, 2 x 2 CQUAD4.
HeatIsoMat;1;200.;9.E+8;2.7E-9
ShellProp;1;1;2.
Node;1;;0.;0.;0.
Node;2;;50.;0.;0.
Node;3;;100.;0.;0.
Node;4;;0.;50.;0.
Node;5;;50.;50.;0.
Node;6;;100.;50.;0.
Node;7;;0.;100.;0.
Node;8;;50.;100.;0.
Node;9;;100.;100.;0.
ShellQuad4;1;1;1;2;5;4
ShellQuad4;2;1;2;3;6;5
ShellQuad4;3;1;4;5;8;7
ShellQuad4;4;1;5;6;9;8
# Top faces of the plate: heated and cooled.
HeatSurfaceSide;21;1;1
HeatSurfaceSide;22;2;1
HeatSurfaceSide;23;3;1
HeatSurfaceSide;24;4;1
# Heater: 0.4 mW/mm2 multiplied by the state of controller 900 (0 or 1).
HeatFluxBoundaryLoad3;10;0.4;900;21;Through;24
HeatController;900;5;Temperature;Thermostat;40.;45.;1;0.
# Free convection (h = 0.01 mW/mm2/K from the MAT4 of the PCONV).
HeatIsoMat;4;;;;0.01
FreeConvectionProp;41;4
FreeConvection;21;41;;;99
FreeConvection;22;41;;;99
FreeConvection;23;41;;;99
FreeConvection;24;41;;;99
# Ambient point, its temperature driven in time (TEMPBC TRAN).
Node;99;;200.;0.;0.
TemperatureBoundary;11;Transient;20.;99
# Time functions: the heater load set 10 at a constant scale, the ambient
# temperature set 11 ramped from 1.0 to 1.5.
DynamicLoadCombination;50;1.;1.;51;1.;52
TransientTableLoad1;51;10;;;;61
TransientTableLoad1;52;11;;;;62
TableDynamic1;61;;;0.;1.;2.E+3;1.;EndTable
TableDynamic1;62;;;0.;1.;1500.;1.5;2.E+3;1.5;EndTable
